---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Noga from '../components/Noga.astro';
import Lightbox from '../components/Lightbox.astro';
import GalerijaSlika from '../components/GalerijaSlika.astro';
import { poLetih } from '../lib/galerija';

/* Skupine so že razvrščene od najnovejše; nepotrjene letnice pridejo na konec. */
const skupine = poLetih();
const stevilo = skupine.reduce((vsota, s) => vsota + s.fotografije.length, 0);
---

<Layout
  title="Galerija — Big Band Grosuplje"
  description="Fotografski arhiv Big Banda Grosuplje: koncerti, vaje in mejniki od zgodnjih let do danes."
>
  <Nav />

  <main class="stran">
    <div class="ovoj">
      <p class="nadnaslov">iz arhiva</p>
      <h1>Galerija</h1>
      <p class="uvod">
        {stevilo} fotografij iz arhiva društva, od najnovejših do najstarejših.
        Klikni fotografijo za povečavo; med njimi listaš s puščicama ali s
        tipkama ← in →.
      </p>
    </div>

    {skupine.map((skupina) => (
      <section class="leto" aria-labelledby={`leto-${skupina.naslov.replace(/\s+/g, '-')}`}>
        <div class="ovoj">
          <h2 id={`leto-${skupina.naslov.replace(/\s+/g, '-')}`} class="leto__naslov">
            {skupina.naslov}
          </h2>
          <ul class="slike">
            {skupina.fotografije.map((f) => <GalerijaSlika foto={f} />)}
          </ul>
        </div>
      </section>
    ))}

    <div class="ovoj">
      <p class="kredit">
        Foto: arhiv KD Big Band Grosuplje. Fotografije zunanjih avtorjev so
        objavljene šele po potrjenem dovoljenju in vedno s podpisom avtorja.
      </p>
    </div>
  </main>

  <Noga />
  <Lightbox />
</Layout>

<style>
  .stran { padding: 52px 0 20px; }
  h1 {
    margin: 10px 0 18px;
    font-size: clamp(28px, 4.4vw, 44px);
    color: var(--bbg-gold-light);
  }
  .uvod {
    margin: 0 0 10px;
    max-width: 42rem;
    opacity: 0.9;
  }

  .leto { padding: 42px 0 0; }
  .leto__naslov {
    margin: 0 0 22px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--bbg-border-dark);
    font-size: clamp(22px, 3vw, 30px);
    color: var(--bbg-gold);
  }
  .slike {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .kredit {
    margin: 52px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--bbg-border-dark);
    font-size: 12.5px;
    line-height: 1.7;
    opacity: 0.65;
    max-width: 44rem;
  }
</style>
