<script>
  /* ---------- Multimedija: en skupen modal ---------- */
  const videoModal = document.querySelector<HTMLDialogElement>('#video-modal');
  const videoOkvir = document.querySelector<HTMLElement>('#video-okvir');

  function zapriVideo() {
    /* iframe odstranimo iz DOM — predvajanje se s tem ustavi. */
    if (videoOkvir) videoOkvir.replaceChildren();
  }

  document.querySelectorAll<HTMLButtonElement>('.video__gumb').forEach((gumb) => {
    gumb.addEventListener('click', () => {
      if (!videoModal || !videoOkvir) return;
      const id = gumb.dataset.videoId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = gumb.dataset.videoNaslov ?? 'Posnetek Big Banda Grosuplje';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      videoOkvir.replaceChildren(iframe);
      videoModal.showModal();
    });
  });

  videoModal?.addEventListener('click', (dogodek) => {
    const cilj = dogodek.target as HTMLElement;
    /* Klik izven okvirja ali na gumb × zapre modal. */
    if (cilj.closest('[data-zapri]') || !cilj.closest('.modal__okvir')) {
      videoModal.close();
    }
  });
  /* close pokrije tudi Esc, ki ga <dialog> obdela sam. */
  videoModal?.addEventListener('close', zapriVideo);

  /* ---------- Galerija: lightbox ---------- */
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
  const lightboxSlika = document.querySelector<HTMLImageElement>('#lightbox-slika');
  const lightboxOpis = document.querySelector<HTMLElement>('#lightbox-opis');

  document.querySelectorAll<HTMLButtonElement>('.slika__gumb').forEach((gumb) => {
    gumb.addEventListener('click', () => {
      if (!lightbox || !lightboxSlika) return;
      lightboxSlika.src = gumb.dataset.slika ?? '';
      lightboxSlika.alt = gumb.dataset.opis ?? '';
      if (lightboxOpis) lightboxOpis.textContent = gumb.dataset.opis ?? '';
      lightbox.showModal();
    });
  });

  /* Zapiranje s klikom kamorkoli; Esc obdela <dialog> sam. */
  lightbox?.addEventListener('click', () => lightbox.close());
  lightbox?.addEventListener('close', () => {
    if (lightboxSlika) lightboxSlika.src = '';
  });

  /* ---------- Obrazci ---------- */
  const EPOSTA = 'info@bigband-grosuplje.com';

  function stanje(obrazec: HTMLFormElement, sporocilo: string, napaka = false) {
    const polje = obrazec.querySelector<HTMLElement>('.obrazec__stanje');
    if (!polje) return;
    polje.textContent = sporocilo;
    polje.classList.toggle('obrazec__stanje--napaka', napaka);
  }

  /* Kontaktna obrazca: Web3Forms, dokler ključa ni — mailto. */
  document.querySelectorAll<HTMLFormElement>('.obrazec').forEach((obrazec) => {
    obrazec.addEventListener('submit', async (dogodek) => {
      dogodek.preventDefault();
      if (!obrazec.reportValidity()) return;

      const podatki = new FormData(obrazec);
      /* Honeypot: če je izpolnjen, tiho odnehamo. */
      if (podatki.get('botcheck')) return;

      const ime = String(podatki.get('ime') ?? '');
      const eposta = String(podatki.get('eposta') ?? '');
      const sporocilo = String(podatki.get('sporocilo') ?? '');
      const podrocje = podatki.get('podrocje');
      const kljuc = obrazec.dataset.w3fKey ?? '';
      const zadeva = String(podatki.get('subject') ?? 'Sporočilo s spletne strani');

      if (kljuc === '') {
        const telo = [
          `Ime: ${ime}`,
          `E-pošta: ${eposta}`,
          podrocje ? `Področje: ${podrocje}` : null,
          '',
          sporocilo,
        ]
          .filter((vrstica) => vrstica !== null)
          .join('\n');
        window.location.href = `mailto:${EPOSTA}?subject=${encodeURIComponent(zadeva)}&body=${encodeURIComponent(telo)}`;
        stanje(obrazec, 'Odpiramo tvoj e-poštni odjemalec s pripravljenim sporočilom.');
        return;
      }

      stanje(obrazec, 'Pošiljamo …');
      try {
        const odziv = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: podatki,
        });
        const izid = await odziv.json();
        if (odziv.ok && izid.success) {
          obrazec.reset();
          stanje(obrazec, 'Sporočilo je oddano. Oglasimo se v nekaj dneh.');
        } else {
          stanje(obrazec, `Pošiljanje ni uspelo. Piši nam na ${EPOSTA}.`, true);
        }
      } catch {
        stanje(obrazec, `Pošiljanje ni uspelo. Piši nam na ${EPOSTA}.`, true);
      }
    });
  });

  /* E-novice: Brevo, dokler URL ni nastavljen — mailto. */
  const novice = document.querySelector<HTMLFormElement>('#novice');
  novice?.addEventListener('submit', (dogodek) => {
    const brevo = novice.dataset.brevo ?? '';
    if (brevo !== '') return; /* pravi POST na Brevo prepustimo brskalniku */

    dogodek.preventDefault();
    if (!novice.reportValidity()) return;
    const podatki = new FormData(novice);
    if (podatki.get('email_address_check')) return;

    const naslov = String(podatki.get('EMAIL') ?? '').trim();
    if (!naslov) return;
    const telo = `Prijavljam se na e-novice Big Banda Grosuplje.\nE-naslov: ${naslov}\nSoglašam s politiko zasebnosti.\n`;
    window.location.href = `mailto:${EPOSTA}?subject=${encodeURIComponent('Prijava na e-novice')}&body=${encodeURIComponent(telo)}`;
    stanje(novice, 'Odpiramo tvoj e-poštni odjemalec s pripravljenim sporočilom.');
  });
</script>

