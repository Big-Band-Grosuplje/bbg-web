---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Noga from '../components/Noga.astro';
import Lightbox from '../components/Lightbox.astro';
import VideoModal from '../components/VideoModal.astro';
import Posnetek from '../components/Posnetek.astro';
import GalerijaSlika from '../components/GalerijaSlika.astro';
import znakZlat from '../assets/brand/bbg-znak-zlat.svg';
import fotoHero from '../assets/foto/orkester/kotar-dirigent-energija.jpg';
/* Hero predoglega smeri A — glej docs/design/README.md. */
import fotoHeroA from '../assets/foto/hero/hero-kazina-zlati-napis-2026.jpg';
import koncertiData from '../data/koncerti.json';
import zgodovinaData from '../data/zgodovina.json';
import { najnovejse } from '../lib/galerija';
import { najnovejsi } from '../lib/mediji';
import { WEB3FORMS_KEY, KONTAKT_EPOSTA } from '../config';

const SITE = 'https://bigband-grosuplje.com';

const KANALI = {
  facebook: 'https://www.facebook.com/BigBandGrosuplje',
  instagram: 'https://www.instagram.com/bigbandgrosuplje/',
};

type Gost = { naziv: string; tip: string | null };
type Lokacija = {
  naziv: string;
  ulica?: string | null;
  postna?: string | null;
  kraj: string;
  drzava?: string | null;
} | null;
type Koncert = {
  id: string;
  naziv: string;
  opis: string;
  opisSeo?: string;
  gostje: Gost[];
  datumIso: string | null;
  ura: string | null;
  datumOpis: string;
  lokacija: Lokacija;
  vstopniceUrl: string | null;
};

const koncerti = koncertiData.koncerti as Koncert[];

/* Datum v sl-SI zapisu: polni datum kot d. M. yyyy, sam mesec kot "oktober 2026".
   Ob znani uri se doda "ob 19.00" (slovenski zapis ure s piko). */
function formatDatum(datumIso: string | null, ura: string | null): string | null {
  if (!datumIso) return null;
  if (/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) {
    const datum = new Intl.DateTimeFormat('sl-SI', {
      day: 'numeric',
      month: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(datumIso + 'T00:00:00Z'));
    return ura ? `${datum} ob ${ura.replace(':', '.')}` : datum;
  }
  if (/^\d{4}-\d{2}$/.test(datumIso)) {
    return new Intl.DateTimeFormat('sl-SI', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(datumIso + '-01T00:00:00Z'));
  }
  return null;
}

/* Datum razstavljen za temni blok na kartici: dan, mesec, leto ločeno. */
function datumBlok(datumIso: string | null) {
  if (!datumIso || !/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) return null;
  const d = new Date(datumIso + 'T00:00:00Z');
  return {
    dan: new Intl.DateTimeFormat('sl-SI', { day: 'numeric', timeZone: 'UTC' }).format(d),
    mesec: new Intl.DateTimeFormat('sl-SI', { month: 'short', timeZone: 'UTC' }).format(d),
    leto: new Intl.DateTimeFormat('sl-SI', { year: 'numeric', timeZone: 'UTC' }).format(d),
  };
}

/* Prihajajoč = brez znanega datuma (napovedan, a še ne uvrščen) ali datum v prihodnosti.
   Filtriranje se izvede ob buildu — po preteku koncerta je potrebna nova objava. */
function jePrihajajoc(datumIso: string | null): boolean {
  if (!datumIso) return true;
  const danes = new Date();
  danes.setUTCHours(0, 0, 0, 0);
  if (/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) {
    return new Date(datumIso + 'T00:00:00Z') >= danes;
  }
  if (/^\d{4}-\d{2}$/.test(datumIso)) {
    const [leto, mesec] = datumIso.split('-').map(Number);
    return new Date(Date.UTC(leto, mesec, 0)) >= danes;
  }
  return true;
}

/* Časovni odmik za Europe/Ljubljana ob danem trenutku — septembra CEST (+02:00),
   decembra CET (+01:00). Odmika ne zapisujemo v podatke, ker se z datumom spreminja. */
function odmikLjubljana(datumIso: string, ura: string): string {
  const priblizek = new Date(`${datumIso}T${ura}:00Z`);
  const zapis = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Ljubljana',
    timeZoneName: 'longOffset',
  })
    .formatToParts(priblizek)
    .find((del) => del.type === 'timeZoneName')?.value;
  const odmik = (zapis ?? '').replace('GMT', '');
  return odmik === '' ? 'Z' : odmik;
}

/* startDate po ISO 8601: z uro vključno s časovnim odmikom, brez ure samo datum. */
function startDate(datumIso: string, ura: string | null): string {
  if (!ura || !/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) return datumIso;
  return `${datumIso}T${ura}:00${odmikLjubljana(datumIso, ura)}`;
}

/* JSON-LD nastane samo, če sta znana datum in lokacija — nepopoln MusicEvent
   je za iskalnike slabši od nobenega. Za description uporabimo nevtralni
   opisSeo, ne duhovitega besedila s kartice. */
function musicEvent(k: Koncert) {
  if (!k.datumIso || !k.lokacija) return null;
  const izvajalci: Record<string, string>[] = [
    { '@type': 'MusicGroup', name: 'Big Band Grosuplje', url: SITE },
  ];
  for (const gost of k.gostje) {
    if (gost.tip) izvajalci.push({ '@type': gost.tip, name: gost.naziv });
  }
  const dogodek: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'MusicEvent',
    name: k.naziv,
    description: k.opisSeo ?? k.opis,
    startDate: startDate(k.datumIso, k.ura),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    performer: izvajalci,
    organizer: {
      '@type': 'Organization',
      name: 'Kulturno društvo Big Band Grosuplje',
      url: SITE,
    },
    location: {
      '@type': 'Place',
      name: k.lokacija.naziv,
      address: {
        '@type': 'PostalAddress',
        ...(k.lokacija.ulica ? { streetAddress: k.lokacija.ulica } : {}),
        ...(k.lokacija.postna ? { postalCode: k.lokacija.postna } : {}),
        addressLocality: k.lokacija.kraj,
        addressCountry: k.lokacija.drzava ?? 'SI',
      },
    },
  };
  if (k.vstopniceUrl) {
    dogodek.offers = {
      '@type': 'Offer',
      url: k.vstopniceUrl,
      availability: 'https://schema.org/InStock',
    };
  }
  return dogodek;
}

const prihajajoci = koncerti
  .filter((k) => jePrihajajoc(k.datumIso))
  .map((k) => ({
    ...k,
    datumPrikaz: formatDatum(k.datumIso, k.ura) ?? k.datumOpis,
    blok: datumBlok(k.datumIso),
    jsonLd: musicEvent(k),
  }));

/* Izseki na naslovnici — celotna vsebina je na podstranih. */
const posnetkiIzsek = najnovejsi(3);
const fotografijeIzsek = najnovejse(6);
const predstavitev = zgodovinaData.predstavitev;
const mejniki = zgodovinaData.mejniki as {
  leto: string;
  naslov: string;
  besedilo: string;
}[];

const web3formsVklopljen = WEB3FORMS_KEY !== '';

/* Hero predoglega A je CSS ozadje, ne <img>. Razlog: skrit <img> Chrome
   prenese tudi z loading="lazy" (display:none nima okvira, zato odložitev
   odpade), s čimer bi privzeti skin C plačal 37 kB po nepotrebnem. Ozadje
   v var(--hero-a) se ne zahteva, dokler pravilo ne velja — izmerjeno.
   Cena: pri A ni srcset. Za predogled je to sprejemljivo. */
const heroA = await getImage({ src: fotoHeroA, width: 900, format: 'webp' });
const heroARazmerje = `${fotoHeroA.width} / ${fotoHeroA.height}`;
---

<Layout>
  <Nav naslovnica={true} />

  <main class="hero">
    <div class="ovoj hero__mreza">
      <div class="hero__besedilo">
        <p class="bbg-badge bbg-rot-badge hero__badge">Pozor, hud big band!</p>
        <img
          src={znakZlat.src}
          alt="Big Band Grosuplje"
          class="hero__znak bbg-rot-znak"
          width="420"
        />
        <p class="hero__slogan">
          Od leta 1997/98 igramo bolje. Ali pa hitreje. Nekaj od tega vsekakor.
        </p>
        <p class="hero__gumbi">
          <a href="#koncerti" class="bbg-gumb">Kdaj igramo?</a>
          <a href="#kontakt" class="bbg-gumb bbg-gumb--obris">Pridruži se</a>
        </p>
      </div>

      <div
        class="hero__foto"
        style={`--hero-a: url('${heroA.src}'); --hero-a-razmerje: ${heroARazmerje};`}
      >
        <Image
          src={fotoHero}
          alt="Dirigent med vodenjem orkestra"
          width={900}
          loading="eager"
          class="bbg-rot-foto hero__slika--c"
        />
        {/* Predogled A: skin se določi šele v brskalniku, zato je element
            vedno v oznakah, sliko pa nosi CSS ozadje (glej opombo zgoraj). */}
        <div
          class="hero__slika--a"
          role="img"
          aria-label="Zlati napis Jazz kluba Kazina pred koncertom"
        ></div>
        <span class="hero__nalepka bbg-rot-nalepka">dirigent, presenetljivo miren</span>
      </div>
    </div>
  </main>

  <section class="sekcija" id="koncerti" aria-labelledby="koncerti-naslov">
    <div class="ovoj">
      <p class="nadnaslov">prihajajoče</p>
      <h2 id="koncerti-naslov">Kdaj in kje igramo</h2>

      {prihajajoci.length === 0 ? (
        <p class="prazno">
          Trenutno ni napovedanih koncertov. Novice objavljamo na
          <a href={KANALI.facebook} target="_blank" rel="noopener noreferrer">Facebooku</a> in
          <a href={KANALI.instagram} target="_blank" rel="noopener noreferrer">Instagramu</a>.
        </p>
      ) : (
        <ul class="kartice">
          {prihajajoci.map((k) => (
            <li class="kartica bbg-mikro-kartica">
              {k.blok ? (
                <p class="kartica__blok">
                  <span class="kartica__dan">{k.blok.dan}</span>
                  <span class="kartica__mesec">{k.blok.mesec}</span>
                  <span class="kartica__leto">{k.blok.leto}</span>
                </p>
              ) : (
                <p class="kartica__blok kartica__blok--brez">
                  <span class="kartica__mesec">{k.datumPrikaz}</span>
                </p>
              )}

              <div class="kartica__telo">
                <h3 class="kartica__naziv">{k.naziv}</h3>
                <p class="kartica__meta">
                  {k.datumPrikaz}
                  {k.lokacija
                    ? ` · ${k.lokacija.naziv}, ${k.lokacija.kraj}`
                    : ' · prizorišče še ni potrjeno'}
                </p>
                <p class="kartica__opis">{k.opis}</p>
                {k.gostje.length > 0 && (
                  <p class="kartica__gostje">
                    <span class="oznaka">Gostje</span>
                    {k.gostje.map((g) => g.naziv).join(', ')}
                  </p>
                )}
                {/* Prodaja vstopnic je vedno na tuji domeni — novi zavihek. */}
                {k.vstopniceUrl && (
                  <p class="kartica__cta">
                    <a
                      class="bbg-gumb bbg-gumb--mali"
                      href={k.vstopniceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >Vstopnice</a>
                  </p>
                )}
              </div>

              {k.jsonLd && (
                <script type="application/ld+json" set:html={JSON.stringify(k.jsonLd)} />
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="sekcija" id="zgodovina" aria-labelledby="zgodovina-naslov">
    <div class="ovoj">
      <p class="nadnaslov">od 1997/98 do danes</p>
      <h2 id="zgodovina-naslov">Zgodovina</h2>

      <p class="zgodovina__uvod">{predstavitev}</p>

      <ol class="mejniki" style={`--stolpci: ${mejniki.length}`}>
        {mejniki.map((m) => (
          <li class="mejnik">
            <p class="mejnik__leto">{m.leto}</p>
            <h3 class="mejnik__naslov">{m.naslov}</h3>
            <p class="mejnik__opis">{m.besedilo}</p>
          </li>
        ))}
      </ol>

      <p class="vec">
        <a class="bbg-gumb bbg-gumb--obris" href="/zgodovina">Celotna zgodovina →</a>
      </p>
    </div>
  </section>

  <section class="sekcija" id="galerija" aria-labelledby="galerija-naslov">
    <div class="ovoj">
      <p class="nadnaslov">iz arhiva</p>
      <h2 id="galerija-naslov">Galerija</h2>

      <ul class="slike">
        {fotografijeIzsek.map((f) => <GalerijaSlika foto={f} />)}
      </ul>

      <p class="vec">
        <a class="bbg-gumb bbg-gumb--obris" href="/galerija">Celotna galerija →</a>
      </p>
      <p class="galerija__kredit">Foto: arhiv KD Big Band Grosuplje</p>
    </div>
  </section>

  <section class="sekcija" id="multimedija" aria-labelledby="mediji-naslov">
    <div class="ovoj">
      <p class="nadnaslov">arhiv posnetkov</p>
      <h2 id="mediji-naslov">Multimedija</h2>

      <ul class="posnetki">
        {posnetkiIzsek.map((m) => <Posnetek medij={m} />)}
      </ul>

      <p class="vec">
        <a class="bbg-gumb bbg-gumb--obris" href="/multimedija">Vsi posnetki →</a>
      </p>
    </div>
  </section>

  <section class="sekcija" id="kontakt" aria-labelledby="kontakt-naslov">
    <div class="ovoj">
      <p class="nadnaslov">pišite nam</p>
      <h2 id="kontakt-naslov">Kontakt</h2>

      <div class="dvostolpca">
        <div class="panel bbg-mikro-levo">
          <h3>Za organizatorje</h3>
          <p>
            Gala večer, festival ali praznovanje? Big band doda prireditvi blišč
            — z repertoarjem od Sinatre do Goodwina, v polni zasedbi ali kot combo.
          </p>

          <form
            class="obrazec"
            data-obrazec="organizator"
            data-w3f-key={WEB3FORMS_KEY}
            action={web3formsVklopljen ? 'https://api.web3forms.com/submit' : undefined}
            method="post"
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Povpraševanje za nastop (bigband-grosuplje.com)" />
            <input type="hidden" name="from_name" value="Spletna stran BBG" />
            {/* honeypot za robote — človek tega polja ne vidi */}
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <label for="org-ime">Ime in priimek</label>
            <input id="org-ime" name="ime" type="text" autocomplete="name" required />

            <label for="org-eposta">E-pošta</label>
            <input id="org-eposta" name="eposta" type="email" autocomplete="email" required />

            <label for="org-sporocilo">Sporočilo</label>
            <textarea id="org-sporocilo" name="sporocilo" rows="4" required></textarea>

            <button class="bbg-gumb" type="submit">Povprašajte za nastop</button>
            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
        </div>

        <div class="panel panel--akcent bbg-mikro-desno">
          <h3>Pridruži se</h3>
          <p>
            Igraš trobento, pozavno, saks ali ritem? Poješ? Te vleče v snemanje
            in ozvočenje? Combo in saksofonski kvintet sta odskočna deska v orkester.
          </p>

          <form
            class="obrazec"
            data-obrazec="pridruzitev"
            data-w3f-key={WEB3FORMS_KEY}
            action={web3formsVklopljen ? 'https://api.web3forms.com/submit' : undefined}
            method="post"
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Pridružitev orkestru (bigband-grosuplje.com)" />
            <input type="hidden" name="from_name" value="Spletna stran BBG" />
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <label for="pri-ime">Ime in priimek</label>
            <input id="pri-ime" name="ime" type="text" autocomplete="name" required />

            <label for="pri-eposta">E-pošta</label>
            <input id="pri-eposta" name="eposta" type="email" autocomplete="email" required />

            <label for="pri-podrocje">Področje</label>
            <select id="pri-podrocje" name="podrocje" required>
              <option value="instrumentalist">Instrumentalist</option>
              <option value="vokalist">Vokalist</option>
              <option value="tehnicna-podpora">Tehnična podpora</option>
            </select>

            <label for="pri-sporocilo">Sporočilo</label>
            <textarea id="pri-sporocilo" name="sporocilo" rows="4" required></textarea>

            <button class="bbg-gumb bbg-gumb--obris" type="submit">Piši nam</button>
            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Noga />
  <VideoModal />
  <Lightbox />
</Layout>

<script>
  /* Kontaktna obrazca: Web3Forms, dokler ključa ni — mailto. */
  const EPOSTA = 'info@bigband-grosuplje.com';

  function stanje(obrazec: HTMLFormElement, sporocilo: string, napaka = false) {
    const polje = obrazec.querySelector<HTMLElement>('.obrazec__stanje');
    if (!polje) return;
    polje.textContent = sporocilo;
    polje.classList.toggle('obrazec__stanje--napaka', napaka);
  }

  document.querySelectorAll<HTMLFormElement>('.obrazec').forEach((obrazec) => {
    obrazec.addEventListener('submit', async (dogodek) => {
      dogodek.preventDefault();
      if (!obrazec.reportValidity()) return;

      const podatki = new FormData(obrazec);
      if (podatki.get('botcheck')) return; /* honeypot */

      const ime = String(podatki.get('ime') ?? '');
      const eposta = String(podatki.get('eposta') ?? '');
      const sporocilo = String(podatki.get('sporocilo') ?? '');
      const podrocje = podatki.get('podrocje');
      const kljuc = obrazec.dataset.w3fKey ?? '';
      const zadeva = String(podatki.get('subject') ?? 'Sporočilo s spletne strani');

      if (kljuc === '') {
        const telo = [
          `Ime: ${ime}`,
          `E-pošta: ${eposta}`,
          podrocje ? `Področje: ${podrocje}` : null,
          '',
          sporocilo,
        ]
          .filter((vrstica) => vrstica !== null)
          .join('\n');
        window.location.href = `mailto:${EPOSTA}?subject=${encodeURIComponent(zadeva)}&body=${encodeURIComponent(telo)}`;
        stanje(obrazec, 'Odpiramo tvoj e-poštni odjemalec s pripravljenim sporočilom.');
        return;
      }

      stanje(obrazec, 'Pošiljamo …');
      try {
        const odziv = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: podatki,
        });
        const izid = await odziv.json();
        if (odziv.ok && izid.success) {
          obrazec.reset();
          stanje(obrazec, 'Sporočilo je oddano. Oglasimo se v nekaj dneh.');
        } else {
          stanje(obrazec, `Pošiljanje ni uspelo. Piši nam na ${EPOSTA}.`, true);
        }
      } catch {
        stanje(obrazec, `Pošiljanje ni uspelo. Piši nam na ${EPOSTA}.`, true);
      }
    });
  });
</script>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 70px 0 90px;
    background:
      radial-gradient(
        60% 55% at 78% 30%,
        color-mix(in srgb, var(--bbg-gold) 16%, transparent) 0%,
        transparent 100%
      ),
      var(--bbg-bg);
  }
  .hero__mreza {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 44px;
    align-items: center;
  }
  .hero__badge { margin: 0 0 20px; }
  .hero__znak {
    width: min(420px, 86%);
    height: auto;
    display: block;
  }
  .hero__slogan {
    margin: 22px 0 30px;
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 600;
    font-style: italic;
    color: var(--bbg-naslov);
    max-width: 30rem;
  }
  .hero__gumbi {
    margin: 0;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  /* Okvir fotografije ostane raven; zarotirana je samo nalepka. */
  .hero__foto { position: relative; }
  .hero__foto img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--bbg-r-l);
    border: 3px solid var(--bbg-gold);
    box-shadow: var(--bbg-senca-foto);
  }
  .hero__nalepka {
    position: absolute;
    bottom: -16px;
    left: -14px;
    background: var(--bbg-nalepka-bg);
    color: var(--bbg-nalepka-besedilo);
    font-family: var(--bbg-font-naslov);
    font-size: 14px;
    padding: 9px 16px;
    border-radius: var(--bbg-r-s);
  }

  /* --- Koncerti --- */
  .prazno { margin: 0; }
  .kartice {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 30px;
  }
  .kartica {
    display: flex;
    gap: 26px;
    background: var(--bbg-kartica-bg);
    color: var(--bbg-kartica-besedilo);
    border-radius: var(--bbg-r-l);
    padding: 28px;
    box-shadow: var(--bbg-senca-kartica);
  }
