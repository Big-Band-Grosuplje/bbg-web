---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import znakZlat from '../assets/brand/bbg-znak-zlat.svg';
import koncertiData from '../data/koncerti.json';
import medijiData from '../data/mediji.json';
import { BREVO_FORM_URL, WEB3FORMS_KEY, KONTAKT_EPOSTA } from '../config';

/* Fotografije: samo tiste v lasti društva.
   Fotografije s TODO dovoljenjem iz docs/foto-manifest.md (Zakrajšek, Požrl,
   ZPF_6631) so v repozitoriju, na stran pa ne gredo, dokler dovoljenja niso
   potrjena. Podnapisi ne vsebujejo imen članov orkestra. */
import fotoHero from '../assets/foto/hero/hero-kazina-zlati-napis-2026.jpg';
import fotoOrkesterIgra from '../assets/foto/orkester/orkester-igra-2026.jpg';
import fotoSaksofoniTrobente from '../assets/foto/orkester/saksofoni-trobente-2026.jpg';
import fotoSolistaKlarinetFlavta from '../assets/foto/orkester/solista-klarinet-flavta-2026.jpg';
import fotoSolistkaAlt from '../assets/foto/orkester/orkester-solistka-alt-2026.jpg';
import fotoNapovedKazina from '../assets/foto/orkester/kotar-napoved-kazina-2026.jpg';
import fotoVajaSkupinska from '../assets/foto/orkester/vaja-skupinska-2024.jpg';
import fotoUsEmbassyCombo from '../assets/foto/zgodovina/mejnik-us-embassy-combo-2017.jpg';

const SITE = 'https://bigband-grosuplje.com';

const KANALI = {
  facebook: 'https://www.facebook.com/BigBandGrosuplje',
  instagram: 'https://www.instagram.com/bigbandgrosuplje/',
  youtube: 'https://www.youtube.com/@bigbandgrosuplje9236',
};

type Gost = { naziv: string; tip: string | null };
type Lokacija = {
  naziv: string;
  ulica?: string | null;
  postna?: string | null;
  kraj: string;
  drzava?: string | null;
} | null;
type Koncert = {
  id: string;
  naziv: string;
  opis: string;
  opisSeo?: string;
  gostje: Gost[];
  datumIso: string | null;
  ura: string | null;
  datumOpis: string;
  lokacija: Lokacija;
  vstopniceUrl: string | null;
};

type Krediti = {
  kamera?: string;
  avdio?: string;
  montaza?: string;
  posnetek?: string;
  kanal?: string;
};
type Medij = {
  id: string;
  naslov: string;
  avtor_glasbe?: string;
  zasedba: string;
  solisti: string[];
  dogodek: string;
  leto: number;
  krediti: Krediti;
  objavi: boolean;
  opomba?: string;
};

const koncerti = koncertiData.koncerti as Koncert[];

/* Datum v sl-SI zapisu: polni datum kot d. M. yyyy, sam mesec kot "oktober 2026".
   Ob znani uri se doda "ob 19.00" (slovenski zapis ure s piko). */
function formatDatum(datumIso: string | null, ura: string | null): string | null {
  if (!datumIso) return null;
  if (/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) {
    const datum = new Intl.DateTimeFormat('sl-SI', {
      day: 'numeric',
      month: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(datumIso + 'T00:00:00Z'));
    return ura ? `${datum} ob ${ura.replace(':', '.')}` : datum;
  }
  if (/^\d{4}-\d{2}$/.test(datumIso)) {
    return new Intl.DateTimeFormat('sl-SI', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(datumIso + '-01T00:00:00Z'));
  }
  return null;
}

/* Datum razstavljen za temni blok na kartici: dan, mesec, leto ločeno. */
function datumBlok(datumIso: string | null) {
  if (!datumIso || !/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) return null;
  const d = new Date(datumIso + 'T00:00:00Z');
  return {
    dan: new Intl.DateTimeFormat('sl-SI', { day: 'numeric', timeZone: 'UTC' }).format(d),
    mesec: new Intl.DateTimeFormat('sl-SI', { month: 'short', timeZone: 'UTC' }).format(d),
    leto: new Intl.DateTimeFormat('sl-SI', { year: 'numeric', timeZone: 'UTC' }).format(d),
  };
}

/* Prihajajoč = brez znanega datuma (napovedan, a še ne uvrščen) ali datum v prihodnosti.
   Filtriranje se izvede ob buildu — po preteku koncerta je potrebna nova objava. */
function jePrihajajoc(datumIso: string | null): boolean {
  if (!datumIso) return true;
  const danes = new Date();
  danes.setUTCHours(0, 0, 0, 0);
  if (/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) {
    return new Date(datumIso + 'T00:00:00Z') >= danes;
  }
  if (/^\d{4}-\d{2}$/.test(datumIso)) {
    const [leto, mesec] = datumIso.split('-').map(Number);
    return new Date(Date.UTC(leto, mesec, 0)) >= danes;
  }
  return true;
}

/* Časovni odmik za Europe/Ljubljana ob danem trenutku — septembra CEST (+02:00),
   decembra CET (+01:00). Odmika ne zapisujemo v podatke, ker se z datumom spreminja. */
function odmikLjubljana(datumIso: string, ura: string): string {
  const priblizek = new Date(`${datumIso}T${ura}:00Z`);
  const zapis = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Ljubljana',
    timeZoneName: 'longOffset',
  })
    .formatToParts(priblizek)
    .find((del) => del.type === 'timeZoneName')?.value;
  const odmik = (zapis ?? '').replace('GMT', '');
  return odmik === '' ? 'Z' : odmik;
}

/* startDate po ISO 8601: z uro vključno s časovnim odmikom, brez ure samo datum. */
function startDate(datumIso: string, ura: string | null): string {
  if (!ura || !/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) return datumIso;
  return `${datumIso}T${ura}:00${odmikLjubljana(datumIso, ura)}`;
}

/* JSON-LD nastane samo, če sta znana datum in lokacija — nepopoln MusicEvent
   je za iskalnike slabši od nobenega. Za description uporabimo nevtralni
   opisSeo, ne duhovitega besedila s kartice. */
function musicEvent(k: Koncert) {
  if (!k.datumIso || !k.lokacija) return null;
  const izvajalci: Record<string, string>[] = [
    { '@type': 'MusicGroup', name: 'Big Band Grosuplje', url: SITE },
  ];
  for (const gost of k.gostje) {
    if (gost.tip) izvajalci.push({ '@type': gost.tip, name: gost.naziv });
  }
  const dogodek: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'MusicEvent',
    name: k.naziv,
    description: k.opisSeo ?? k.opis,
    startDate: startDate(k.datumIso, k.ura),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    performer: izvajalci,
    organizer: {
      '@type': 'Organization',
      name: 'Kulturno društvo Big Band Grosuplje',
      url: SITE,
    },
    location: {
      '@type': 'Place',
      name: k.lokacija.naziv,
      address: {
        '@type': 'PostalAddress',
        ...(k.lokacija.ulica ? { streetAddress: k.lokacija.ulica } : {}),
        ...(k.lokacija.postna ? { postalCode: k.lokacija.postna } : {}),
        addressLocality: k.lokacija.kraj,
        addressCountry: k.lokacija.drzava ?? 'SI',
      },
    },
  };
  if (k.vstopniceUrl) {
    dogodek.offers = {
      '@type': 'Offer',
      url: k.vstopniceUrl,
      availability: 'https://schema.org/InStock',
    };
  }
  return dogodek;
}

const prihajajoci = koncerti
  .filter((k) => jePrihajajoc(k.datumIso))
  .map((k) => ({
    ...k,
    datumPrikaz: formatDatum(k.datumIso, k.ura) ?? k.datumOpis,
    blok: datumBlok(k.datumIso),
    jsonLd: musicEvent(k),
  }));

/* --- Multimedija --- */

const mediji = (medijiData as Medij[]).filter((m) => m.objavi);

/* Vrstni red kreditov je fiksen; izpišejo se samo tisti, ki v podatkih obstajajo.
   Polje "opomba" je interno in se na stran nikoli ne izpiše. */
const KREDIT_OZNAKE: [keyof Krediti, string][] = [
  ['kamera', 'Kamera'],
  ['avdio', 'Avdio'],
  ['montaza', 'Montaža'],
  ['posnetek', 'Posnetek'],
  ['kanal', 'Kanal'],
];

function kreditiVrstica(krediti: Krediti): string | null {
  const deli = KREDIT_OZNAKE.filter(([klic]) => krediti[klic]).map(
    ([klic, oznaka]) => `${oznaka}: ${krediti[klic]}`,
  );
  return deli.length > 0 ? deli.join(' · ') : null;
}

/* uploadDate zahteva datum, podatki pa hranijo samo leto — zato 1. januar
   tega leta. To ni dejanski datum objave posnetka, ampak najboljši približek
   iz razpoložljivega vira. */
function videoObject(m: Medij) {
  return {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: m.naslov,
    uploadDate: `${m.leto}-01-01`,
    thumbnailUrl: `https://i.ytimg.com/vi/${m.id}/hqdefault.jpg`,
    embedUrl: `https://www.youtube.com/embed/${m.id}`,
  };
}

const posnetki = mediji.map((m) => ({
  ...m,
  slika: `https://i.ytimg.com/vi/${m.id}/hqdefault.jpg`,
  kreditiPrikaz: kreditiVrstica(m.krediti),
  jsonLd: videoObject(m),
}));

/* --- Galerija ---
   Podnapisi po docs/foto-manifest.md: fotografije iz mape orkester/ so
   s koncertov Poklon Gordonu Goodwinu (2026), izjema je skupinska vaja 2024;
   pri zgodovinskih je dogodek v imenu datoteke. */
const galerijaVir = [
  {
    slika: fotoOrkesterIgra,
    podnapis: 'Poklon Gordonu Goodwinu, 2026 — orkester med izvedbo',
  },
  {
    slika: fotoSaksofoniTrobente,
    podnapis: 'Poklon Gordonu Goodwinu, 2026 — saksofonska in trobilna sekcija',
  },
  {
    slika: fotoSolistaKlarinetFlavta,
    podnapis: 'Poklon Gordonu Goodwinu, 2026 — solista na klarinetu in flavti',
  },
  {
    slika: fotoSolistkaAlt,
    podnapis: 'Poklon Gordonu Goodwinu, 2026 — solistka na alt saksofonu',
  },
  {
    slika: fotoNapovedKazina,
    podnapis: 'Poklon Gordonu Goodwinu, Jazz klub Kazina, Ljubljana, 2026',
  },
  { slika: fotoVajaSkupinska, podnapis: 'Skupinska vaja orkestra, 2024' },
  {
    slika: fotoUsEmbassyCombo,
    podnapis: 'Combo na dogodku ameriškega veleposlaništva, 2017',
  },
];

/* Za lightbox pripravimo večjo različico iste fotografije. */
const galerija = await Promise.all(
  galerijaVir.map(async (g) => ({
    ...g,
    velika: await getImage({ src: g.slika, width: 1600, format: 'webp' }),
  })),
);

/* --- Obrazci --- */
const brevoVklopljen = BREVO_FORM_URL !== '';
const web3formsVklopljen = WEB3FORMS_KEY !== '';
---

<Layout>
  <main class="hero">
    <div class="ovoj hero__mreza">
      <div class="hero__besedilo">
        <p class="bbg-badge bbg-rot-badge hero__badge">Pozor, hud big band!</p>
        <img
          src={znakZlat.src}
          alt="Big Band Grosuplje"
          class="hero__znak bbg-rot-znak"
          width="420"
        />
        <p class="hero__slogan">
          Od leta 1997/98 igramo bolje. Ali pa hitreje. Nekaj od tega vsekakor.
        </p>
        <p class="hero__gumbi">
          <a href="#koncerti" class="bbg-gumb">Kdaj igramo?</a>
          <a href="#kontakt" class="bbg-gumb bbg-gumb--obris">Pridruži se</a>
        </p>
      </div>

      <div class="hero__foto">
        <Image src={fotoHero} alt="Big Band Grosuplje na odru" width={900} loading="eager" />
      </div>
    </div>
  </main>

  <section class="sekcija" id="koncerti" aria-labelledby="koncerti-naslov">
    <div class="ovoj">
      <p class="nadnaslov">prihajajoče</p>
      <h2 id="koncerti-naslov">Kdaj in kje igramo</h2>

      {prihajajoci.length === 0 ? (
        <p class="prazno">
          Trenutno ni napovedanih koncertov. Novice objavljamo na
          <a href={KANALI.facebook}>Facebooku</a> in
          <a href={KANALI.instagram}>Instagramu</a>.
        </p>
      ) : (
        <ul class="kartice">
          {prihajajoci.map((k) => (
            <li class="kartica">
              {k.blok ? (
                <p class="kartica__blok">
                  <span class="kartica__dan">{k.blok.dan}</span>
                  <span class="kartica__mesec">{k.blok.mesec}</span>
                  <span class="kartica__leto">{k.blok.leto}</span>
                </p>
              ) : (
                <p class="kartica__blok kartica__blok--brez">
                  <span class="kartica__mesec">{k.datumPrikaz}</span>
                </p>
              )}

              <div class="kartica__telo">
                <h3 class="kartica__naziv">{k.naziv}</h3>
                <p class="kartica__meta">
                  {k.datumPrikaz}
                  {k.lokacija
                    ? ` · ${k.lokacija.naziv}, ${k.lokacija.kraj}`
                    : ' · prizorišče še ni potrjeno'}
                </p>
                <p class="kartica__opis">{k.opis}</p>
                {k.gostje.length > 0 && (
                  <p class="kartica__gostje">
                    <span class="oznaka">Gostje</span>
                    {k.gostje.map((g) => g.naziv).join(', ')}
                  </p>
                )}
                {k.vstopniceUrl && (
                  <p class="kartica__cta">
                    <a class="bbg-gumb bbg-gumb--mali" href={k.vstopniceUrl}>Vstopnice</a>
                  </p>
                )}
              </div>

              {k.jsonLd && (
                <script type="application/ld+json" set:html={JSON.stringify(k.jsonLd)} />
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="sekcija" id="multimedija" aria-labelledby="mediji-naslov">
    <div class="ovoj">
      <p class="nadnaslov">arhiv posnetkov</p>
      <h2 id="mediji-naslov">Multimedija</h2>

      <ul class="posnetki">
        {posnetki.map((m) => (
          <li class="posnetek">
            <div class="video__ovoj">
              <img
                class="video__slika"
                src={m.slika}
                alt={`Sličica posnetka: ${m.naslov}`}
                width="480"
                height="360"
                loading="lazy"
              />
              <button
                class="video__gumb"
                type="button"
                data-video-id={m.id}
                data-video-naslov={m.naslov}
                aria-label={`Predvajaj posnetek: ${m.naslov}`}
              >
                <span class="video__ikona" aria-hidden="true"></span>
              </button>
            </div>

            <h3 class="posnetek__naslov">{m.naslov}</h3>
            {m.avtor_glasbe && <p class="posnetek__avtor">{m.avtor_glasbe}</p>}
            <p class="posnetek__zasedba">{m.zasedba}</p>
            {m.solisti.length > 0 && (
              <p class="posnetek__solisti">
                <span class="oznaka">Solisti</span>
                {m.solisti.join(', ')}
              </p>
            )}
            <p class="posnetek__dogodek">{m.dogodek}, {m.leto}</p>
            {m.kreditiPrikaz && <p class="posnetek__krediti">{m.kreditiPrikaz}</p>}

            <script type="application/ld+json" set:html={JSON.stringify(m.jsonLd)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sekcija" id="galerija" aria-labelledby="galerija-naslov">
    <div class="ovoj">
      <p class="nadnaslov">iz arhiva</p>
      <h2 id="galerija-naslov">Galerija</h2>

      <ul class="slike">
        {galerija.map((g) => (
          <li class="slika">
            <figure>
              <button
                type="button"
                class="slika__gumb"
                data-slika={g.velika.src}
                data-opis={g.podnapis}
                aria-label={`Povečaj fotografijo: ${g.podnapis}`}
              >
                <Image src={g.slika} alt={g.podnapis} width={800} loading="lazy" />
              </button>
              <figcaption>{g.podnapis}</figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <p class="galerija__kredit">Foto: arhiv KD Big Band Grosuplje</p>
    </div>
  </section>

  <section class="sekcija" id="kontakt" aria-labelledby="kontakt-naslov">
    <div class="ovoj">
      <p class="nadnaslov">pišite nam</p>
      <h2 id="kontakt-naslov">Kontakt</h2>

      <div class="dvostolpca">
        <div class="panel">
          <h3>Za organizatorje</h3>
          <p>
            Gala večer, festival ali praznovanje? Big band doda prireditvi blišč
            — z repertoarjem od Sinatre do Goodwina, v polni zasedbi ali kot combo.
          </p>

          <form
            class="obrazec"
            data-obrazec="organizator"
            data-w3f-key={WEB3FORMS_KEY}
            action={web3formsVklopljen ? 'https://api.web3forms.com/submit' : undefined}
            method="post"
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Povpraševanje za nastop (bigband-grosuplje.com)" />
            <input type="hidden" name="from_name" value="Spletna stran BBG" />
            {/* honeypot za robote — človek tega polja ne vidi */}
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <label for="org-ime">Ime in priimek</label>
            <input id="org-ime" name="ime" type="text" autocomplete="name" required />

            <label for="org-eposta">E-pošta</label>
            <input id="org-eposta" name="eposta" type="email" autocomplete="email" required />

            <label for="org-sporocilo">Sporočilo</label>
            <textarea id="org-sporocilo" name="sporocilo" rows="4" required></textarea>

            <button class="bbg-gumb" type="submit">Povprašajte za nastop</button>
            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
        </div>

        <div class="panel panel--akcent">
          <h3>Pridruži se</h3>
          <p>
            Igraš trobento, pozavno, saks ali ritem? Poješ? Te vleče v snemanje
            in ozvočenje? Combo in saksofonski kvintet sta odskočna deska v orkester.
          </p>

          <form
            class="obrazec"
            data-obrazec="pridruzitev"
            data-w3f-key={WEB3FORMS_KEY}
            action={web3formsVklopljen ? 'https://api.web3forms.com/submit' : undefined}
            method="post"
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Pridružitev orkestru (bigband-grosuplje.com)" />
            <input type="hidden" name="from_name" value="Spletna stran BBG" />
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <label for="pri-ime">Ime in priimek</label>
            <input id="pri-ime" name="ime" type="text" autocomplete="name" required />

            <label for="pri-eposta">E-pošta</label>
            <input id="pri-eposta" name="eposta" type="email" autocomplete="email" required />

            <label for="pri-podrocje">Področje</label>
            <select id="pri-podrocje" name="podrocje" required>
              <option value="instrumentalist">Instrumentalist</option>
              <option value="vokalist">Vokalist</option>
              <option value="tehnicna-podpora">Tehnična podpora</option>
            </select>

            <label for="pri-sporocilo">Sporočilo</label>
            <textarea id="pri-sporocilo" name="sporocilo" rows="4" required></textarea>

            <button class="bbg-gumb bbg-gumb--obris" type="submit">Piši nam</button>
            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <footer class="noga">
    <div class="ovoj">
      <div class="noga__mreza">
        <div class="noga__znamka">
          <img src={znakZlat.src} alt="Big Band Grosuplje" width="150" class="noga__znak" />
          <p class="noga__ton">Prvi grosupeljški big band — od leta 1997/98.</p>
        </div>

        <div class="noga__novice">
          <h3 class="noga__naslov">Ne zamudi koncerta</h3>
          <form
            class="novice"
            id="novice"
            data-brevo={BREVO_FORM_URL}
            action={brevoVklopljen ? BREVO_FORM_URL : undefined}
            method="post"
            novalidate
          >
            <div class="novice__vrstica">
              <label class="vizualno-skrito" for="novice-email">Tvoja e-pošta</label>
              <input
                class="novice__vnos"
                id="novice-email"
                name="EMAIL"
                type="email"
                autocomplete="email"
                placeholder="tvoj@email.si"
                required
              />
              <button class="bbg-gumb bbg-gumb--mali" type="submit">Prijava</button>
            </div>

            {/* Brevov honeypot — robot ga izpolni, človek ga ne vidi */}
            <input type="text" name="email_address_check" class="honeypot" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="locale" value="sl" />

            <p class="novice__soglasje">
              <label>
                <input type="checkbox" name="soglasje" required />
                Strinjam se s <a href="/zasebnost">politiko zasebnosti</a>.
              </label>
            </p>

            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
          <p class="noga__drobno">
            Nekaj obvestil na leto, samo o koncertih. Brez spama, častna pihalska.
          </p>
        </div>

