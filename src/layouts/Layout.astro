---
/* Pisave so samo-gostovane prek @fontsource — nikoli Google Fonts CDN,
   ker bi ta prenesel IP obiskovalca tretji osebi (GDPR).
   Uvozimo samo podnabora latin in latin-ext; latin-ext nosi č, š, ž. */
import '@fontsource/archivo-black/latin-400.css';
import '@fontsource/archivo-black/latin-ext-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-ext-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-ext-600.css';
import '@fontsource/archivo/latin-ext-800.css';

/* Pisavi predoglega smeri A. Uvoz doda samo @font-face pravila (~1 kB CSS);
   brskalnik woff2 prenese šele, ko je družina dejansko uporabljena — torej
   ob [data-skin="a"], ko --font-display/--font-body kažeta nanju. Pri
   privzetem skin=c ni nobenega dodatnega prenosa. @fontsource že nastavi
   font-display: swap. latin-ext nosi č, š, ž. */
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-ext-700.css';
import '@fontsource/playfair-display/latin-500-italic.css';
import '@fontsource/playfair-display/latin-ext-500-italic.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-ext-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-ext-600.css';

import '../styles/brand.css';
import Analytics from '@vercel/analytics/astro';

import {
  POTI,
  preslikavaZaSkripto,
  razlicice,
  slovar,
  type Jezik,
  type Stran,
} from '../i18n';

interface Props {
  /* Ključ strani iz POTI — iz njega nastanejo hreflang pari in
     preusmeritev. Brez njega bi bilo treba poti pisati na vsaki strani
     posebej in bi se razšle. */
  stran: Stran;
  jezik: Jezik;
  title?: string;
  description?: string;
  /* Dinamične strani (podstrani dogodkov) v POTI ne morejo biti, ker jih
     ni znano vnaprej. Te podajo svoj par poti tu; `stran` pri njih pove
     samo, katera pot velja za samodejno preusmeritev jezika. */
  potiRazlicic?: { sl: string; en: string };
}

const { stran, jezik, title, description, potiRazlicic } = Astro.props;
const t = slovar(jezik);

const naslovStrani = title ?? t.naslovnica.naslovStrani;
const opisStrani = description ?? t.naslovnica.opisStrani;

const SITE = Astro.site ?? new URL('https://bigband-grosuplje.com');
const ogImage = new URL('/og/og-default.png', SITE);

const paroma = potiRazlicic
  ? [
      { jezik: 'sl' as Jezik, pot: potiRazlicic.sl },
      { jezik: 'en' as Jezik, pot: potiRazlicic.en },
    ]
  : razlicice(stran);
const kanonicna = new URL(potiRazlicic ? potiRazlicic[jezik] : POTI[stran][jezik], SITE);
const alternative = paroma.map((r) => ({
  jezik: r.jezik,
  url: new URL(r.pot, SITE).href,
}));

/* MusicGroup je na VSAKI strani, ker je to identiteta orkestra, ne vsebina
   posamezne strani — iskalniki in jeziki modeli tako dobijo dejstva ne glede
   na to, kje pristanejo. Kanali so isti kot v nogi (src/components/Noga.astro).
   Uradnega naziva ne krajšaj: "Kulturno društvo Big Band Grosuplje".

   Sam orkester je ista entiteta v obeh jezikih, zato @id ostane isti in se
   različici ne podvajata kot dva subjekta. Po jeziku se spremenita samo
   description in inLanguage. */
const musicGroup = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': `${SITE.origin}/#orkester`,
  name: 'Big Band Grosuplje',
  description: opisStrani,
  inLanguage: t.htmlLang,
  alternateName: 'Kulturno društvo Big Band Grosuplje',
  foundingDate: '1997',
  genre: ['jazz', 'swing', 'big band'],
  url: `${SITE.origin}/`,
  logo: new URL('/icon-512.png', SITE).href,
  image: ogImage.href,
  email: 'info@bigband-grosuplje.com',
  sameAs: [
    'https://www.facebook.com/BigBandGrosuplje',
    'https://www.instagram.com/bigbandgrosuplje/',
    'https://www.youtube.com/@bigbandgrosuplje9236',
  ],
  location: {
    '@type': 'Place',
    name: 'Grosuplje',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Adamičeva cesta 16',
      postalCode: '1290',
      addressLocality: 'Grosuplje',
      addressCountry: 'SI',
    },
  },
};
---

<!doctype html>
<html lang={t.htmlLang} data-skin="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Skin in tema se postavita PRED izrisom, da ni bliska napačnega videza.

        SKIN: privzeta je potrjena smer "a" (Zlati klub). data-skin="a" je
        zapisan že v oznaki <html> zgoraj, ne šele tu — tako privzeta smer
        velja tudi brez JS in se pisave smeri A uveljavijo ob prvem izrisu,
        Archivo pa se ne prenese. Komentarja NE prestavljaj pred <html>:
        Astro tam izgubi korenski element in z njim lang ter data-skin.
        Ta skripta atribut samo po potrebi prepiše na "c". ?skin=c ali
        ?skin=a izbiro shrani v localStorage (bbg-skin) in jo takoj uporabi,
        sicer velja shranjena. Javnega gumba za preklop ni — predogled
        smeri C se vklopi samo prek parametra.

        TEMA: privzeta je TEMNA. Sistemske nastavitve (prefers-color-scheme)
        namenoma ne upoštevamo — svetla velja samo, kadar jo je obiskovalec
        izbral s preklopnikom. Izbira velja v obeh smereh; obe imata svetlo
        temo. */}
    <script is:inline>
      (() => {
        const html = document.documentElement;
        let skin = 'a';
        let tema = null;
        try {
          const zahtevan = new URLSearchParams(window.location.search).get('skin');
          if (zahtevan === 'a' || zahtevan === 'c') {
            localStorage.setItem('bbg-skin', zahtevan);
            skin = zahtevan;
          } else if (localStorage.getItem('bbg-skin') === 'c') {
            skin = 'c';
          }
          tema = localStorage.getItem('bbg-tema');
        } catch (e) {
          /* zasebni način ipd. — ostaneta privzeta smer A in temna tema */
        }
        html.dataset.skin = skin;
        html.dataset.theme = tema === 'light' ? 'light' : 'dark';
      })();
    </script>

    {/* JEZIK: slovenščina je privzeta, angleščina živi pod /en/.
        Ob PRVEM obisku (ko bbg-lang še ni shranjen) in samo na slovenski
        strani pogledamo navigator.languages: če noben vpis ne začne s "sl",
        obiskovalca preusmerimo na angleško različico iste strani. Pot in
        query se ohranita, zato skin in tema preživita preusmeritev.
        Vsaka izbira — samodejna ali ročna prek gumba v navigaciji — se
        shrani v bbg-lang in je nikoli več ne preglasimo.
        Skripta teče samo na slovenskih straneh; angleške je ne potrebujejo,
        ker je obisk /en/ že sam po sebi izbira. */}
    {jezik === 'sl' && (
      <script
        is:inline
        define:vars={{
          preslikava: {
            ...preslikavaZaSkripto(),
            /* Podstrani dogodkov v POTI ni, zato njen par dodamo tu —
               brez tega angleško govorečega obiskovalca s podstrani
               dogodka ne bi preusmerilo. */
            ...(potiRazlicic ? { [potiRazlicic.sl]: potiRazlicic.en } : {}),
          },
        }}
      >
        (() => {
          try {
            if (localStorage.getItem('bbg-lang')) return;
            const jeziki = navigator.languages || [navigator.language || ''];
            if (jeziki.some((j) => String(j).toLowerCase().startsWith('sl'))) return;
            const cilj = preslikava[window.location.pathname];
            if (!cilj) return;
            localStorage.setItem('bbg-lang', 'en');
            window.location.replace(cilj + window.location.search + window.location.hash);
          } catch (e) {
            /* zasebni način ipd. — obiskovalec ostane na slovenski različici */
          }
        })();
      </script>
    )}

    <title>{naslovStrani}</title>
    <meta name="description" content={opisStrani} />

    <link rel="canonical" href={kanonicna.href} />
    {alternative.map((a) => (
      <link rel="alternate" hreflang={a.jezik} href={a.url} />
    ))}
    {/* x-default kaže na slovensko različico — to je izhodiščni jezik strani. */}
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternative.find((a) => a.jezik === 'sl')?.url}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="Big Band Grosuplje" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:url" content={kanonicna.href} />
    <meta property="og:title" content={naslovStrani} />
    <meta property="og:description" content={opisStrani} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(musicGroup)} />
  </head>
  <body>
    <slot />

    {/* Vidna samo pri skin=c (CSS v brand.css) — edina pot nazaj na privzeto
        smer A brez tipkanja URL-ja. Vedno v oznakah, ker se skin lahko
        spremeni šele v brskalniku. */}
    <button type="button" class="predogled" id="predogled-skin">
      {t.skupno.predogledC} <span class="predogled__nazaj">{t.skupno.predogledNazaj}</span>
    </button>

    <Analytics />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

  /* Barvna shema za sistemske gradnike (drsniki, izbirniki, polja).
     Privzeto temna, tudi brez JS — sistemske nastavitve ne upoštevamo. */
  :root { color-scheme: dark; }
  :root[data-theme='light'] { color-scheme: light; }

  body {
    /* Po mockupu smer-c.html: 500 17px/1.62 */
    font-family: var(--bbg-font-besedilo);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.62;
    background: var(--bbg-bg);
    color: var(--bbg-besedilo);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 {
    font-family: var(--bbg-font-naslov);
    font-weight: 400;   /* Archivo Black ima samo eno težo */
    letter-spacing: 0.005em;
  }
  strong, b { font-weight: 800; }

  /* Osnova za povezave: barva pride iz teme, ker privzeta
     modra/vijolična brskalnika ni berljiva na nobeni od podlag.
     visited je enak kot normal. */
  a,
  a:link,
  a:visited,
  a:active {
    color: var(--bbg-povezava);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  a:hover,
  a:focus-visible { color: var(--bbg-povezava-hover); }
</style>

<script>
  /* Vrnitev iz predoglega smeri C na privzeto smer A. Strani ni treba
     naložiti znova — vse je vezano na data-skin, zato zadošča zamenjava
     atributa. */
  document.querySelector<HTMLButtonElement>('#predogled-skin')?.addEventListener('click', () => {
    const html = document.documentElement;
    try {
      localStorage.setItem('bbg-skin', 'a');
    } catch (e) {
      /* zasebni način — vrnitev velja do osvežitve strani */
    }
    html.dataset.skin = 'a';

    /* Brez tega bi osvežitev strani predogled takoj vrnila. */
    const naslov = new URL(window.location.href);
    if (naslov.searchParams.has('skin')) {
      naslov.searchParams.delete('skin');
      history.replaceState(null, '', naslov.pathname + naslov.search + naslov.hash);
    }
  });
</script>
