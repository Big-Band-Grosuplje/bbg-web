---
/* Pisave so samo-gostovane prek @fontsource — nikoli Google Fonts CDN,
   ker bi ta prenesel IP obiskovalca tretji osebi (GDPR).
   Uvozimo samo podnabora latin in latin-ext; latin-ext nosi č, š, ž. */
import '@fontsource/archivo-black/latin-400.css';
import '@fontsource/archivo-black/latin-ext-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-ext-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-ext-600.css';
import '@fontsource/archivo/latin-ext-800.css';
import '../styles/brand.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Big Band Grosuplje',
  description = 'Big Band Grosuplje — klasična big band zasedba, ki deluje od leta 1997/98. Koncerti, tematski programi in izobraževalne delavnice.',
} = Astro.props;

const SITE = Astro.site ?? new URL('https://bigband-grosuplje.com');
const ogImage = new URL('/og/og-default.png', SITE);

/* MusicGroup je na VSAKI strani, ker je to identiteta orkestra, ne vsebina
   posamezne strani — iskalniki in jeziki modeli tako dobijo dejstva ne glede
   na to, kje pristanejo. Kanali so isti kot v nogi (src/components/Noga.astro).
   Uradnega naziva ne krajšaj: "Kulturno društvo Big Band Grosuplje". */
const musicGroup = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': `${SITE.origin}/#orkester`,
  name: 'Big Band Grosuplje',
  alternateName: 'Kulturno društvo Big Band Grosuplje',
  foundingDate: '1997',
  genre: ['jazz', 'swing', 'big band'],
  url: `${SITE.origin}/`,
  logo: new URL('/icon-512.png', SITE).href,
  image: ogImage.href,
  email: 'info@bigband-grosuplje.com',
  sameAs: [
    'https://www.facebook.com/BigBandGrosuplje',
    'https://www.instagram.com/bigbandgrosuplje/',
    'https://www.youtube.com/@bigbandgrosuplje9236',
  ],
  location: {
    '@type': 'Place',
    name: 'Grosuplje',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Adamičeva cesta 16',
      postalCode: '1290',
      addressLocality: 'Grosuplje',
      addressCountry: 'SI',
    },
  },
};
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Tema se postavi PRED izrisom, da ni bliska napačne teme.
        Privzeta je TEMNA. Sistemske nastavitve (prefers-color-scheme)
        namenoma ne upoštevamo — svetla tema velja samo, kadar jo je
        obiskovalec izbral s preklopnikom in je izbira v localStorage. */}
    <script is:inline>
      (() => {
        let izbrana = null;
        try {
          izbrana = localStorage.getItem('bbg-tema');
        } catch (e) {
          /* zasebni način ipd. — ostane privzeta temna */
        }
        document.documentElement.dataset.theme = izbrana === 'light' ? 'light' : 'dark';
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="Big Band Grosuplje" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(musicGroup)} />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

  /* Barvna shema za sistemske gradnike (drsniki, izbirniki, polja).
     Privzeto temna, tudi brez JS — sistemske nastavitve ne upoštevamo. */
  :root { color-scheme: dark; }
  :root[data-theme='light'] { color-scheme: light; }

  body {
    /* Po mockupu smer-c.html: 500 17px/1.62 */
    font-family: var(--bbg-font-besedilo);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.62;
    background: var(--bbg-bg);
    color: var(--bbg-besedilo);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 {
    font-family: var(--bbg-font-naslov);
    font-weight: 400;   /* Archivo Black ima samo eno težo */
    letter-spacing: 0.005em;
  }
  strong, b { font-weight: 800; }

  /* Osnova za povezave: barva pride iz teme, ker privzeta
     modra/vijolična brskalnika ni berljiva na nobeni od podlag.
     visited je enak kot normal. */
  a,
  a:link,
  a:visited,
  a:active {
    color: var(--bbg-povezava);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  a:hover,
  a:focus-visible { color: var(--bbg-povezava-hover); }
</style>
