---
import znakZlat from '../assets/brand/bbg-znak-zlat.svg';
import { BREVO_FORM_URL, KONTAKT_EPOSTA } from '../config';

const KANALI = {
  facebook: 'https://www.facebook.com/BigBandGrosuplje',
  instagram: 'https://www.instagram.com/bigbandgrosuplje/',
  youtube: 'https://www.youtube.com/@bigbandgrosuplje9236',
};

const brevoVklopljen = BREVO_FORM_URL !== '';
---

<footer class="noga">
  <div class="ovoj">
    <div class="noga__mreza">
      <div class="noga__znamka">
        <img src={znakZlat.src} alt="Big Band Grosuplje" width="150" class="noga__znak" />
        <p class="noga__ton">Prvi grosupeljski big band — od leta 1997/98.</p>
      </div>

      <div class="noga__novice">
        <h3 class="noga__naslov">Ne zamudi koncerta</h3>
        {/* action in method sta tu za primer brez JS: takrat obrazec odda
            navaden POST na Brevo. Ker gre na tujo domeno, se odpre v novem
            zavihku, da obiskovalec ne izgubi naše strani. Z JS do tega ne
            pride — skripta oddajo prestreže in pošlje prek fetch. */}
        <form
          class="novice"
          id="novice"
          data-brevo={BREVO_FORM_URL}
          action={brevoVklopljen ? BREVO_FORM_URL : undefined}
          method="post"
          target={brevoVklopljen ? '_blank' : undefined}
          rel={brevoVklopljen ? 'noopener noreferrer' : undefined}
          novalidate
        >
          <div class="novice__vrstica">
            <label class="vizualno-skrito" for="novice-email">Tvoja e-pošta</label>
            <input
              class="novice__vnos"
              id="novice-email"
              name="EMAIL"
              type="email"
              autocomplete="email"
              placeholder="tvoj@email.si"
              required
            />
            <button class="bbg-gumb bbg-gumb--mali" type="submit">Prijava</button>
          </div>

          {/* Brevov honeypot — robot ga izpolni, človek ga ne vidi.
              Ime polja predpisuje Brevo in ga ne spreminjaj. */}
          <input type="text" name="email_address_check" class="honeypot" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="locale" value="en" />

          {/* Potrditev je pogoj za oddajo, Brevu pa je ne pošiljamo: polje
              nima atributa name, zato ni del oddanih podatkov — niti prek
              fetch niti pri navadnem POST brez JS. required kljub temu
              velja, ker ga preverja brskalnik. */}
          <p class="novice__soglasje">
            <label>
              <input type="checkbox" required />
              Strinjam se s <a href="/zasebnost">politiko zasebnosti</a>.
            </label>
          </p>

          <p class="obrazec__stanje" role="status" aria-live="polite"></p>
        </form>
        <p class="noga__drobno">
          Nekaj obvestil na leto, samo o koncertih. Brez spama, častna jazzovska.
        </p>
      </div>

      <nav class="noga__kanali" aria-label="Družbena omrežja">
        <h3 class="noga__naslov">Spremljaj nas</h3>
        {/* Zunanje domene se odpirajo v novem zavihku; rel prepreči, da bi
            odprta stran prek window.opener segla nazaj v našo. Interne
            povezave ostanejo v istem oknu. */}
        <p class="kanali__povezave">
          <a href={KANALI.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> ·
          <a href={KANALI.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> ·
          <a href={KANALI.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
        </p>
        <p class="noga__drobno">
          <a href={`mailto:${KONTAKT_EPOSTA}`}>{KONTAKT_EPOSTA}</a><br />
          <a href="/zasebnost">Politika zasebnosti</a>
        </p>
      </nav>
    </div>

    <p class="kolofon">
      Kulturno društvo Big Band Grosuplje · Adamičeva cesta 16, 1290 Grosuplje<br />
      Davčna številka: 12579076 (nismo zavezanci za DDV) · Matična številka: 1179241000 ·
      <a href={`mailto:${KONTAKT_EPOSTA}`}>{KONTAKT_EPOSTA}</a>
    </p>
  </div>
</footer>

<script>
  /* E-novice.

     IZBRANA POT: fetch. Brevov endpoint sibforms.com/serve dovoljuje CORS —
     na preflight vrne access-control-allow-origin z odsevanim izvorom in
     access-control-allow-methods s POST (preverjeno 31. 8. 2026 za
     produkcijsko domeno, za localhost in za poljuben tretji izvor). Zato je
     odziv berljiv in obiskovalec ostane na strani. Navadnega POST v novem
     zavihku ne potrebujemo; ostane samo kot pot brez JS prek action na
     obrazcu.

     Telo pošljemo kot URLSearchParams in ne kot FormData: Brevov obrazec
     sicer odda application/x-www-form-urlencoded, ta zapis pa je tudi
     varen za CORS in ne sproži preflighta. Vira podatkov to ne spremeni —
     še vedno je FormData obrazca.

     redirect: 'manual' — če Brevo odgovori s preusmeritvijo, je ne
     sledimo: cilj morda nima CORS glav in bi fetch padel, čeprav je
     prijava uspela. Tak odziv pride kot type 'opaqueredirect' in ga
     štejemo za uspeh, enako kot 2xx in 3xx.

     Dokler BREVO_FORM_URL ni nastavljen, obrazec pade na mailto. */
  const EPOSTA = 'info@bigband-grosuplje.com';
  const novice = document.querySelector<HTMLFormElement>('#novice');

  function stanjeNovic(sporocilo: string, napaka = false) {
    const polje = novice?.querySelector<HTMLElement>('.obrazec__stanje');
    if (!polje) return;
    polje.textContent = sporocilo;
    polje.classList.toggle('obrazec__stanje--napaka', napaka);
  }

  novice?.addEventListener('submit', async (dogodek) => {
    dogodek.preventDefault();
    if (!novice.reportValidity()) return;

    const podatki = new FormData(novice);
    if (podatki.get('email_address_check')) return; /* honeypot — tiho končamo */

    const naslov = String(podatki.get('EMAIL') ?? '').trim();
    if (!naslov) return;

    const brevo = novice.dataset.brevo ?? '';
    if (brevo === '') {
      const telo = `Prijavljam se na e-novice Big Banda Grosuplje.\nE-naslov: ${naslov}\nSoglašam s politiko zasebnosti.\n`;
      window.location.href = `mailto:${EPOSTA}?subject=${encodeURIComponent('Prijava na e-novice')}&body=${encodeURIComponent(telo)}`;
      stanjeNovic('Odpiramo tvoj e-poštni odjemalec s pripravljenim sporočilom.');
      return;
    }

    /* Polje soglasja nima atributa name, zato v podatkih ni; sem gredo
       samo EMAIL, email_address_check in locale. */
    const telo = new URLSearchParams();
    podatki.forEach((vrednost, kljuc) => {
      if (typeof vrednost === 'string') telo.append(kljuc, vrednost);
    });

    stanjeNovic('Pošiljamo …');
    try {
      const odziv = await fetch(brevo, {
        method: 'POST',
        body: telo,
        redirect: 'manual',
      });
      const uspeh =
        odziv.ok || odziv.type === 'opaqueredirect' || (odziv.status >= 300 && odziv.status < 400);
      if (uspeh) {
        novice.reset();
        stanjeNovic('Hvala, prijava je zabeležena.');
      } else {
        stanjeNovic(`Prijava ni uspela. Piši nam na ${EPOSTA}.`, true);
      }
    } catch {
      stanjeNovic(`Prijava ni uspela. Piši nam na ${EPOSTA}.`, true);
    }
  });
</script>

<style>
  /* Noga je ravna in nevtralna — brez rotacij. */
  .noga {
    border-top: 3px solid var(--bbg-gold);
    background: var(--bbg-noga-bg);
    padding: 52px 0 30px;
  }
  .noga__mreza {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 36px;
  }
  .noga__znak { height: auto; display: block; }
  .noga__ton {
    margin: 14px 0 0;
    font-style: italic;
    opacity: 0.8;
    font-size: 14px;
  }
  .noga__naslov { margin: 0 0 14px; font-size: 20px; color: var(--bbg-naslov); }
  /* Umirjeno prek barve, ne prek motnosti: motnost stisne tudi povezave v
     istem odstavku in je zlato povezavo spustila na 2,64 :1. Odstotek je
     enak prejšnji motnosti, zato je videz odstavka nespremenjen — mešanje
     s podlago da isto barvo kot prekrivanje z motnostjo. */
  .noga__drobno {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: color-mix(in srgb, var(--bbg-besedilo) 65%, var(--bbg-bg));
  }

  /* Povezave v nogi: zlata, brez podčrtave, visited enako kot normal. */
  .noga a,
  .noga a:link,
  .noga a:visited,
  .noga a:active {
    color: var(--bbg-noga-povezava, var(--bbg-povezava));
    text-decoration: none;
    font-weight: 800;
  }
  .noga a:hover,
  .noga a:focus-visible { text-decoration: underline; }
  .noga .novice__soglasje a { font-weight: 600; text-decoration: underline; }
  .noga .kolofon a { font-weight: 600; }

  .novice { margin: 0; }
  .novice__vrstica {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .novice__vnos {
    flex: 1 1 11rem;
    min-width: 0;
    font-family: var(--bbg-font-besedilo);
    font-weight: 600;
    font-size: 15px;
    padding: 11px 15px;
    background: var(--bbg-vnos-bg);
    color: var(--bbg-vnos-besedilo);
    border: 0;
    border-radius: var(--bbg-r-s);
  }
  .novice__vnos:focus-visible {
    outline: 2px solid var(--bbg-obroba-mocna);
    outline-offset: 2px;
  }
  /* Isti razlog kot pri .noga__drobno — povezava na politiko zasebnosti je
     pri motnosti 0,8 padla na 3,47 :1. */
  .novice__soglasje {
    margin: 12px 0 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--bbg-besedilo) 80%, var(--bbg-bg));
  }
  .novice__soglasje label {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .obrazec__stanje {
    margin: 12px 0 0;
    font-size: 13.5px;
    min-height: 1.2em;
    color: var(--bbg-naslov);
  }
  /* --bbg-napaka izbere odtenek glede na podlago teme; --bbg-accent bi bil
     berljiv samo na papirju. Enako kot pri kontaktnih obrazcih. */
  .obrazec__stanje--napaka { color: var(--bbg-napaka); }
  .kanali__povezave { margin: 0; font-size: 15px; }
  /* V svetli temi je kolofon temen blok, zato barva ne sme biti
     zamegljena z opacity — mutiranje gre prek color-mix. */
  .kolofon {
    margin-top: 40px;
    border-top: 1px solid var(--bbg-kolofon-obroba);
    background: var(--bbg-kolofon-bg);
    color: color-mix(in srgb, var(--bbg-kolofon-besedilo) 72%, transparent);
    border-radius: var(--bbg-r-m);
    padding: 22px 18px;
    font-size: 12.5px;
    text-align: center;
    line-height: 1.8;
  }
  /* Kolofon je v svetli temi temen, zato povezave v njem ostanejo svetle. */
  .noga .kolofon a,
  .noga .kolofon a:link,
  .noga .kolofon a:visited { color: var(--bbg-gold-light); }

  /* --- Predogled smeri A: tanka zlata črta namesto debele, polje v pilulo --- */
  :global(:root[data-skin='a']) .noga {
    border-top: 1px solid color-mix(in srgb, var(--bbg-gold) 30%, transparent);
  }
  :global(:root[data-skin='a']) .novice__vnos {
    border: 1px solid color-mix(in srgb, var(--bbg-gold) 45%, transparent);
    border-radius: 999px;
  }
  :global(:root[data-skin='a']) .noga a { font-weight: 600; }

  @media (max-width: 820px) {
    .noga__mreza { grid-template-columns: 1fr; }
  }
</style>
