---
import { Image, getImage } from 'astro:assets';
import { altZa, podnapisZa, slikaZa, type Fotografija } from '../lib/galerija';
import { slovar, type Jezik } from '../i18n';

interface Props {
  foto: Fotografija;
  jezik: Jezik;
}
const { foto, jezik } = Astro.props;
const t = slovar(jezik);
const podnapis = podnapisZa(foto, jezik);
/* Podnapis gre v figcaption in v lightbox, alt pa opisuje sliko samo —
   zaslonski bralnik bi sicer isto poved slišal dvakrat. */
const nadomestno = altZa(foto, jezik);

/* Podnapis lahko nosi pravi prelom vrstice (glej figcaption: white-space:
   pre-line). Tako je dolg napis mogoče prelomiti za pomišljajem, ne da bi
   se razdelil na dve polji. V atributih prelom ni na mestu — aria-label in
   data-opis dobita napis v eni vrsti. */
const podnapisVrstica = podnapis.split('\n').join(' ');

const vir = slikaZa(foto.datoteka);
/* Za lightbox pripravimo večjo različico iste fotografije. */
const velika = await getImage({ src: vir, width: 1600, format: 'webp' });
---

<li class="slika">
  <figure>
    <button
      type="button"
      class="slika__gumb"
      data-slika={velika.src}
      data-opis={podnapisVrstica}
      aria-label={`${t.lightbox.povecaj}: ${podnapisVrstica}`}
    >
      <Image src={vir} alt={nadomestno} width={800} loading="lazy" />
    </button>
    <figcaption>{podnapis}</figcaption>
  </figure>
</li>

<style>
  .slika figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .slika__gumb {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }
  .slika__gumb:focus-visible {
    outline: 2px solid var(--bbg-obroba-mocna);
    outline-offset: 3px;
  }
  .slika img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--bbg-r-l);
    border: 2.5px solid var(--bbg-gold);
  }
  .slika figcaption {
    font-size: 13.5px;
    line-height: 1.5;
    opacity: 0.78;
    /* pre-line ohrani prelome vrstic iz galerija.json, zaporedne presledke
       pa še vedno strne. Uporablja ga samo napis, ki bi mu pomišljaj sredi
       vrstice pustil dolgo praznino (Flying Start 2024); drugi napisi
       preloma ne vsebujejo, zato zanje to ni sprememba. */
    white-space: pre-line;
  }
</style>
