---
import { Image, getImage } from 'astro:assets';
import { altZa, avtorZa, podnapisZa, slikaZa, type Fotografija } from '../lib/galerija';
import { slovar, type Jezik } from '../i18n';

interface Props {
  foto: Fotografija;
  jezik: Jezik;
}
const { foto, jezik } = Astro.props;
const t = slovar(jezik);
const podnapis = podnapisZa(foto, jezik);
/* Podnapis gre v figcaption in v lightbox, alt pa opisuje sliko samo —
   zaslonski bralnik bi sicer isto poved slišal dvakrat. */
const nadomestno = altZa(foto, jezik);

/* Podnapis lahko nosi pravi prelom vrstice (glej figcaption: white-space:
   pre-line). Tako je dolg napis mogoče prelomiti za pomišljajem, ne da bi
   se razdelil na dve polji. V atributih prelom ni na mestu — aria-label in
   data-opis dobita napis v eni vrsti. */
const podnapisVrstica = podnapis.split('\n').join(' ');

/* Avtor: vpisano polje ali arhiv društva. Napis ga pokaže v svoji vrstici,
   lightbox pa pripetega k opisu; v aria-label gumba ne gre, ker ta
   poimenuje dejanje in ne vsebine. */
const avtor = `${t.galerijaStran.foto}: ${avtorZa(foto, t.galerijaStran.avtorPrivzeto)}`;

const vir = slikaZa(foto.datoteka);
/* Pokončna fotografija bi v mreži postala dvakrat višja od sosed, zato jo
   kartica obreže na isto razmerje kot večina (3 : 2). Orientacijo beremo iz
   same datoteke in ne iz zastavice v podatkih, ki bi ob zamenjavi slike
   ostala pri starem. Lightbox prikaže celo sliko — ta pravila nanj ne
   sežejo, ker ima svoj element. */
const pokoncna = vir.width < vir.height;
/* Za lightbox pripravimo večjo različico iste fotografije. */
const velika = await getImage({ src: vir, width: 1600, format: 'webp' });
---

<li class="slika">
  <figure>
    <button
      type="button"
      class="slika__gumb"
      data-slika={velika.src}
      data-opis={`${podnapisVrstica} · ${avtor}`}
      aria-label={`${t.lightbox.povecaj}: ${podnapisVrstica}`}
    >
      <Image
        src={vir}
        alt={nadomestno}
        width={800}
        loading="lazy"
        class:list={[pokoncna && 'slika--pokoncna']}
      />
    </button>
    {/* Presledek med napisom in avtorjem je nujen v besedilnem toku, ne le
        vizualno: brez njega textContent zlepi zadnjo besedo napisa z
        oznako ("orkesterFoto: …") in zaslonski bralnik prebere zlepek.
        Vizualno ne moti — span je blok, zato se presledek pred njim ne
        izriše. Vse v eni vrstici izvorne kode, ker figcaption teče v
        white-space: pre-line in bi vsak prelom v kodi postal viden. */}
    <figcaption>{podnapis}{' '}<span class="slika__avtor">{avtor}</span></figcaption>
  </figure>
</li>

<style>
  .slika figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .slika__gumb {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }
  .slika__gumb:focus-visible {
    outline: 2px solid var(--bbg-obroba-mocna);
    outline-offset: 3px;
  }
  .slika img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--bbg-r-l);
    border: 2.5px solid var(--bbg-gold);
  }
  /* Pokončna slika v kartici: obrez na razmerje večine (3 : 2), fokus v
     zgornji tretjini, kjer je pri portretu obraz. Lightbox ima svoj
     element in prikaže celo sliko. */
  .slika img.slika--pokoncna {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 25%;
  }
  /* Avtor v svoji vrstici pod napisom. display: block in ne prelom v
     oznakah, ker figcaption teče v white-space: pre-line in bi vsak
     prelom v izvorni kodi postal viden. */
  .slika__avtor {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    color: color-mix(in srgb, var(--bbg-besedilo) 62%, var(--bbg-bg));
  }
  .slika figcaption {
    font-size: 13.5px;
    line-height: 1.5;
    opacity: 0.78;
    /* pre-line ohrani prelome vrstic iz galerija.json, zaporedne presledke
       pa še vedno strne. Uporablja ga samo napis, ki bi mu pomišljaj sredi
       vrstice pustil dolgo praznino (Flying Start 2024); drugi napisi
       preloma ne vsebujejo, zato zanje to ni sprememba. */
    white-space: pre-line;
  }
</style>
