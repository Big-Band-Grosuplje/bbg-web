---
/* ============================================================
   Medijsko ozadje hero sekcije. En vmesnik, TRI stanja.

   Katero velja, se odloči tu in nikjer drugje:

     1. posnetek vpisan v src/data/hero-video.ts
        → tiha zanka (autoplay muted loop playsinline), gumb za zvok,
          pri prefers-reduced-motion plakat
     2. brez posnetka, VEČ slik v src/assets/hero/
        → počasno menjavanje s prehodom; pri prefers-reduced-motion
          samo prva slika
     3. brez posnetka, ENA slika
        → statično ozadje. Brez animacije, brez skripte, brez razlik.

   PRENOS. Prva slika je LCP element naslovnice: pride v oznakah, z
   loading="eager" in fetchpriority="high", brez lazy. Ostale NIMAJO
   atributa src — pot nosijo v data-src in jo skripta pripne šele tik
   pred prvo menjavo. Obiskovalec, ki naslovnico zapusti v treh
   sekundah, zato prenese natanko eno sliko, ne glede na to, koliko jih
   je v mapi.
   ============================================================ */
import { Image, getImage } from 'astro:assets';
import { slovar, type Jezik } from '../i18n';
import { HERO_POSNETEK } from '../data/hero-video';
import { HERO_SLIKE, IMA_SLIDESHOW } from '../lib/hero-slike';

interface Props {
  jezik: Jezik;
  /** Nadomestno besedilo prve slike; ostale so okras iste vsebine. */
  alt: string;
}
const { jezik, alt } = Astro.props;
const t = slovar(jezik);

const [prva, ...ostale] = HERO_SLIKE;

/* Odložene slike pripravimo v dveh širinah. Ena sama 1920 bi telefonu
   poslala namizno sliko, polni srcset pa bi pri sliki, ki je morda nihče
   ne bo videl, ne prinesel dovolj, da bi odtehtal zapletenost. */
const odlozene = await Promise.all(
  ostale.map(async (s) => ({
    ime: s.ime,
    ozka: (await getImage({ src: s.slika, width: 1100, format: 'webp' })).src,
    siroka: (await getImage({ src: s.slika, width: 1920, format: 'webp' })).src,
  })),
);

const plakat = HERO_POSNETEK?.plakat ?? (await getImage({ src: prva.slika, width: 1920, format: 'webp' })).src;
---

{HERO_POSNETEK ? (
  <div class="medij medij--video">
    <video
      class="medij__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={plakat}
      data-zvok-av1={HERO_POSNETEK.zvok.av1}
      data-zvok-h264={HERO_POSNETEK.zvok.h264}
    >
      <source src={HERO_POSNETEK.tiho.av1} type="video/webm" />
      <source src={HERO_POSNETEK.tiho.h264} type="video/mp4" />
    </video>
    <Image
      src={prva.slika}
      alt={alt}
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      class="medij__plakat"
    />
    <button
      class="medij__zvok"
      type="button"
      aria-pressed="false"
      data-vklopi={t.hero.zvokVklopi}
      data-utisaj={t.hero.zvokUtisaj}
    >
      <span class="medij__meter" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="medij__zvokNapis">{t.hero.zvokVklopi}</span>
    </button>
  </div>
) : (
  <div
    class:list={['medij', IMA_SLIDESHOW && 'medij--slideshow']}
    data-trajanje="9000"
    data-prehod="1800"
  >
    {/* LCP element naslovnice. eager + fetchpriority high, nikoli lazy. */}
    <Image
      src={prva.slika}
      alt={alt}
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="medij__slika je-vidna"
    />
    {/* Brez src: pot nosi data-src in jo skripta pripne tik pred menjavo.
        alt je prazen — vsebina je ista kot pri prvi, ki alt že nosi, in
        bralnik zaslona nima kaj pridobiti od treh opisov istega odra. */}
    {odlozene.map((s) => (
      <img
        class="medij__slika"
        alt=""
        aria-hidden="true"
        decoding="async"
        data-src={s.siroka}
        data-srcset={`${s.ozka} 1100w, ${s.siroka} 1920w`}
      />
    ))}
  </div>
)}

<script>
  /* --- Zvok pri posnetku ------------------------------------------- */
  const medijVideo = document.querySelector<HTMLElement>('.medij--video');
  const video = medijVideo?.querySelector<HTMLVideoElement>('.medij__video');
  const gumb = medijVideo?.querySelector<HTMLButtonElement>('.medij__zvok');

  if (video) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
      video.removeAttribute('autoplay');
      video.querySelectorAll('source').forEach((v) => v.remove());
      video.load();
    }

    gumb?.addEventListener('click', () => {
      const napis = gumb.querySelector<HTMLElement>('.medij__zvokNapis');
      if (gumb.getAttribute('aria-pressed') === 'true') {
        video.muted = true;
        gumb.setAttribute('aria-pressed', 'false');
        if (napis) napis.textContent = gumb.dataset.vklopi ?? '';
        return;
      }
      const kje = video.currentTime;
      video.querySelectorAll('source').forEach((v) => v.remove());
      for (const [pot, tip] of [
        [video.dataset.zvokAv1, 'video/webm'],
        [video.dataset.zvokH264, 'video/mp4'],
      ] as [string | undefined, string][]) {
        if (!pot) continue;
        const vir = document.createElement('source');
        vir.src = pot;
        vir.type = tip;
        video.appendChild(vir);
      }
      video.load();
      video.currentTime = kje;
      video.muted = false;
      void video.play();
      gumb.setAttribute('aria-pressed', 'true');
      if (napis) napis.textContent = gumb.dataset.utisaj ?? '';
    });
  }

  /* --- Slideshow ----------------------------------------------------
     Pri eni sami sliki razreda .medij--slideshow ni in spodnje se ne
     zgodi nič — statično ozadje ne potrebuje skripte.

     Prenos je zamaknjen namenoma: naslednja slika se začne nalagati
     šele PREDPRIPRAVA milisekund pred svojo menjavo, ne ob obisku. Kdor
     odide prej, je prenesel eno sliko. */
  const zid = document.querySelector<HTMLElement>('.medij--slideshow');

  if (zid && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const slike = [...zid.querySelectorAll<HTMLImageElement>('.medij__slika')];
    const TRAJANJE = Number(zid.dataset.trajanje) || 9000;
    const PREHOD = Number(zid.dataset.prehod) || 1800;
    const PREDPRIPRAVA = 2500;
    let tekoca = 0;

    function pripni(i: number) {
      const s = slike[i];
      if (!s || s.src || !s.dataset.src) return;
      if (s.dataset.srcset) s.srcset = s.dataset.srcset;
      s.sizes = '100vw';
      s.src = s.dataset.src;
    }

    function naprej() {
      const naslednja = (tekoca + 1) % slike.length;
      slike[tekoca].classList.remove('je-vidna');
      slike[naslednja].classList.add('je-vidna');
      tekoca = naslednja;
      /* Predpripravimo tisto ZA naslednjo, ne naslednjo — ta je že tu. */
      setTimeout(() => pripni((tekoca + 1) % slike.length), TRAJANJE - PREDPRIPRAVA);
      setTimeout(naprej, TRAJANJE);
    }

    /* Prvo menjavo in prvi dodatni prenos sprožimo šele po nalaganju
       strani, da ne tekmujeta z LCP. */
    const zacni = () => {
      setTimeout(() => pripni(1), Math.max(0, TRAJANJE - PREDPRIPRAVA));
      setTimeout(naprej, TRAJANJE);
    };
    if (document.readyState === 'complete') zacni();
    else window.addEventListener('load', zacni, { once: true });

    void PREHOD;
  }
</script>

<style>
  .medij {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Barva pod sliko: dokler se nalaga, hero ni prazna bela ploskev. */
    background: var(--bbg-black);
  }
  .medij__slika,
  .medij__plakat,
  .medij__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Slideshow: vse slike druga na drugi, vidna je ena. Prehod je na
     motnosti in ne na filtrih ali transformih — samo motnost brskalnik
     pelje po GPU brez ponovnega izrisa. */
  .medij--slideshow .medij__slika {
    opacity: 0;
    transition: opacity 1800ms ease-in-out;
  }
  .medij--slideshow .medij__slika.je-vidna { opacity: 1; }

  .medij--video .medij__plakat { display: none; }

  /* --- Gumb za zvok -------------------------------------------------- */
  .medij__zvok {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--bbg-font-besedilo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 8px 14px;
    border-radius: 999px;
    /* Gumb stoji na posnetku, torej na podlagi, ki je ne poznamo. Zato
       nosi svojo temno ploskev in svetlo besedilo v OBEH temah. */
    border: 1px solid color-mix(in srgb, #E3C765 55%, transparent);
    background: rgba(20, 17, 14, 0.66);
    color: #F3EBD8;
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .medij__zvok:hover { background: rgba(20, 17, 14, 0.82); }
  .medij__zvok:focus-visible { outline: 2px solid var(--bbg-gold-light); outline-offset: 3px; }

  .medij__meter { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
  .medij__meter i { width: 2px; background: var(--bbg-gold-light); display: block; }
  .medij__meter i:nth-child(1) { height: 40%; }
  .medij__meter i:nth-child(2) { height: 100%; }
  .medij__meter i:nth-child(3) { height: 62%; }
  .medij__zvok[aria-pressed='true'] .medij__meter i {
    animation: medij-nihaj 900ms ease-in-out infinite alternate;
  }
  .medij__zvok[aria-pressed='true'] .medij__meter i:nth-child(2) { animation-delay: 140ms; }
  .medij__zvok[aria-pressed='true'] .medij__meter i:nth-child(3) { animation-delay: 280ms; }
  @keyframes medij-nihaj { from { height: 30%; } to { height: 100%; } }

  /* --- prefers-reduced-motion ---------------------------------------
     Slideshow: ostane prva slika. Skripta se sploh ne zažene, zato
     ostale ne dobijo src in se ne prenesejo — mirovanje je tu tudi
     prihranek prenosa, ne le manj gibanja.
     Posnetek: plakat namesto videa, gumb za zvok odpade, ker brez
     predvajanja ni česa odtišati. */
  @media (prefers-reduced-motion: reduce) {
    .medij--slideshow .medij__slika { transition: none; }
    .medij--video .medij__video { display: none; }
    .medij--video .medij__plakat { display: block; }
    .medij__zvok { display: none; }
    .medij__zvok[aria-pressed='true'] .medij__meter i { animation: none; }
  }
</style>
