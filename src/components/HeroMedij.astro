---
/* ============================================================
   Medijska plošča hero sekcije (smer b).

   En vmesnik, dve stanji. Katero velja, določi izključno prisotnost
   posnetka v src/data/hero-video.ts:

   - BREZ posnetka: mirujoča fotografija. Brez gumba za zvok, brez
     preklopnika, brez namiga, da kaj manjka. Hero je dokončan.
   - S posnetkom: tiha zanka (autoplay muted loop playsinline), gumb za
     zvok v zgornjem kotu plošče, pri prefers-reduced-motion fotografija.

   Gumb za zvok stoji na PLOŠČI in ne na strani: pripada posnetku in se
   mora seliti z njim, ko plošča pri ozkem zaslonu zleze nad besedilo.
   ============================================================ */
import { Image, getImage } from 'astro:assets';
import { slovar, type Jezik } from '../i18n';
import { HERO_POSNETEK } from '../data/hero-video';

interface Props {
  /** Fotografija: v stanju brez posnetka vsebina plošče, sicer plakat. */
  slika: ImageMetadata;
  alt: string;
  jezik: Jezik;
}
const { slika, alt, jezik } = Astro.props;
const t = slovar(jezik);

/* Plakat je isti kader kot fotografija v stanju brez posnetka, razen če je
   v podatkih vpisan svoj. Ista slika pomeni, da se ob prehodu iz plakata v
   zanko nič ne premakne. */
const plakatSlika = await getImage({ src: slika, width: 900, format: 'webp' });
const plakat = HERO_POSNETEK?.plakat ?? plakatSlika.src;
---

{HERO_POSNETEK ? (
  <div class="medij medij--video">
    {/* autoplay muted playsinline sta pogoj, ne okras: brez muted mobilni
        brskalniki predvajanja ne dovolijo, brez playsinline ga iOS požene
        čez cel zaslon. Atributi ostanejo v oznakah, da zanka teče tudi
        brez JS; za prefers-reduced-motion poskrbita CSS (skrije video,
        pokaže plakat) in skripta spodaj (ustavi prenos). */}
    <video
      class="medij__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={plakat}
      data-zvok-av1={HERO_POSNETEK.zvok.av1}
      data-zvok-h264={HERO_POSNETEK.zvok.h264}
    >
      <source src={HERO_POSNETEK.tiho.av1} type="video/webm" />
      <source src={HERO_POSNETEK.tiho.h264} type="video/mp4" />
    </video>

    {/* Plakat kot samostojna slika, ne le atribut poster: pri
        prefers-reduced-motion mora ostati viden tudi takrat, ko je video
        skrit, in pri tem nositi svoj alt. */}
    <Image src={slika} alt={alt} width={900} loading="eager" class="medij__plakat" />

    <button
      class="medij__zvok"
      type="button"
      aria-pressed="false"
      data-vklopi={t.hero.zvokVklopi}
      data-utisaj={t.hero.zvokUtisaj}
    >
      <span class="medij__meter" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="medij__zvokNapis">{t.hero.zvokVklopi}</span>
    </button>
  </div>
) : (
  <div class="medij">
    <Image src={slika} alt={alt} width={900} loading="eager" class="medij__slika" />
  </div>
)}

<script>
    /* Zanka je v oznakah in teče brez JS. Skripta doda dvoje:
       1. pri prefers-reduced-motion ustavi predvajanje IN odstrani vire,
          da se posnetek sploh ne prenese (CSS ga samo skrije);
       2. gumb za zvok, ki ob kliku zamenja tiho različico s polno. */
    const medij = document.querySelector<HTMLElement>('.medij--video');
    const video = medij?.querySelector<HTMLVideoElement>('.medij__video');
    const gumb = medij?.querySelector<HTMLButtonElement>('.medij__zvok');

    if (video) {
      const miruje = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (miruje.matches) {
        video.pause();
        video.removeAttribute('autoplay');
        video.querySelectorAll('source').forEach((v) => v.remove());
        video.load();
      }

      gumb?.addEventListener('click', () => {
        const napis = gumb.querySelector<HTMLElement>('.medij__zvokNapis');
        if (gumb.getAttribute('aria-pressed') === 'true') {
          video.muted = true;
          gumb.setAttribute('aria-pressed', 'false');
          if (napis) napis.textContent = gumb.dataset.vklopi ?? '';
          return;
        }

        /* Polna različica se prenese šele tu — do klika obiskovalec ni
           plačal niti bajta avdio sledi. Mesto v zanki ohranimo, da
           menjava ni videti kot ponoven začetek. */
        const kje = video.currentTime;
        video.querySelectorAll('source').forEach((v) => v.remove());
        for (const [pot, tip] of [
          [video.dataset.zvokAv1, 'video/webm'],
          [video.dataset.zvokH264, 'video/mp4'],
        ] as [string | undefined, string][]) {
          if (!pot) continue;
          const vir = document.createElement('source');
          vir.src = pot;
          vir.type = tip;
          video.appendChild(vir);
        }
        video.load();
        video.currentTime = kje;
        video.muted = false;
        void video.play();
        gumb.setAttribute('aria-pressed', 'true');
        if (napis) napis.textContent = gumb.dataset.utisaj ?? '';
      });
    }
</script>

<style>
  /* Plošča je v obeh stanjih enako velika in enako uokvirjena, zato se ob
     prihodu posnetka postavitev ne premakne. */
  .medij {
    position: relative;
    border-radius: var(--bbg-r-l);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--bbg-gold) 38%, transparent);
    background: var(--bbg-panel-bg);
  }
  .medij__slika,
  .medij__plakat,
  .medij__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Plakat je viden samo pri prefers-reduced-motion; sicer ga prekriva
     video. Privzeto je torej skrit, ker je zanka privzeto stanje. */
  .medij--video .medij__plakat { display: none; }

  /* --- Gumb za zvok -------------------------------------------------- */
  .medij__zvok {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--bbg-font-besedilo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 8px 14px;
    border-radius: 999px;
    /* Gumb stoji na posnetku, torej na podlagi, ki je ne poznamo. Zato
       nosi svojo temno ploskev in svetlo besedilo v OBEH temah — žetoni
       teme bi ga v svetli temi naredili svetlega na svetlem kadru. */
    border: 1px solid color-mix(in srgb, #E3C765 55%, transparent);
    background: rgba(20, 17, 14, 0.66);
    color: #F3EBD8;
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .medij__zvok:hover { background: rgba(20, 17, 14, 0.82); }
  .medij__zvok:focus-visible {
    outline: 2px solid var(--bbg-gold-light);
    outline-offset: 3px;
  }

  /* Ravni mirujejo, dokler je zvok izklopljen — gumb ponazarja tišino. */
  .medij__meter { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
  .medij__meter i { width: 2px; background: var(--bbg-gold-light); display: block; }
  .medij__meter i:nth-child(1) { height: 40%; }
  .medij__meter i:nth-child(2) { height: 100%; }
  .medij__meter i:nth-child(3) { height: 62%; }
  .medij__zvok[aria-pressed='true'] .medij__meter i {
    animation: medij-nihaj 900ms ease-in-out infinite alternate;
  }
  .medij__zvok[aria-pressed='true'] .medij__meter i:nth-child(2) { animation-delay: 140ms; }
  .medij__zvok[aria-pressed='true'] .medij__meter i:nth-child(3) { animation-delay: 280ms; }
  @keyframes medij-nihaj {
    from { height: 30%; }
    to { height: 100%; }
  }

  /* --- prefers-reduced-motion ---------------------------------------
     Mirovanje ni samo ustavljena animacija: brez predvajanja ni česa
     odtišati, zato gumb za zvok odpade. Plošča ostane enaka — obiskovalec
     ne vidi, da je kaj izpadlo. */
  @media (prefers-reduced-motion: reduce) {
    .medij--video .medij__video { display: none; }
    .medij--video .medij__plakat { display: block; }
    .medij__zvok { display: none; }
    .medij__zvok[aria-pressed='true'] .medij__meter i { animation: none; }
  }
</style>
