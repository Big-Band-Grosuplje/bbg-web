---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Noga from '../Noga.astro';
import Lightbox from '../Lightbox.astro';
import GalerijaSlika from '../GalerijaSlika.astro';
import { fotografijeEre, type EraId } from '../../lib/galerija';
import zgodovinaData from '../../data/zgodovina.json';
import { pot, slovar, type Jezik } from '../../i18n';

interface Props {
  jezik: Jezik;
}
const { jezik } = Astro.props;
const t = slovar(jezik);

type Vnos = { leto: string; besedilo: string; besediloEn?: string };
type Obdobje = {
  id: string;
  obdobje: string;
  obdobjeEn?: string;
  vodstvo: string;
  vloga: string;
  vlogaEn?: string;
  opis: string;
  opisEn?: string;
  vnosi: Vnos[];
};

/* Angleška različica z zasilnim vračilom na slovensko: manjkajoč prevod
   naj pokaže izvirnik, ne prazne vrstice. */
const en = jezik === 'en';
const v = (slovensko: string, angleško?: string) => (en ? (angleško ?? slovensko) : slovensko);

const predstavitev = v(zgodovinaData.predstavitev, zgodovinaData.predstavitevEn);
/* Stavek o smeri branja stoji samo tu: predstavitev bere tudi naslovnica,
   kjer je časovnica krajša in pojasnila ne potrebuje. */
const uvodSmer = v(zgodovinaData.uvodSmer, zgodovinaData.uvodSmerEn);
const gostujociDirigenti = (
  en
    ? ((zgodovinaData.gostujociDirigentiEn ?? zgodovinaData.gostujociDirigenti) as string[])
    : (zgodovinaData.gostujociDirigenti as string[])
);
const jubilej = v(zgodovinaData.jubilej, zgodovinaData.jubilejEn);

/* Fotografije se eram dodelijo po letu in dirigentu iz napisa (glej
   src/lib/galerija.ts) — statičnega seznama imen v zgodovina.json ni več,
   ker se je z letnicami razšel. Razrešimo jih že tu, da so ere brez slik
   prepoznane pred izrisom. Fotografije brez potrjenega dovoljenja avtorja
   v galerija.json niso vpisane, zato se tu ne morejo pojaviti.

   Kronologija se izpisuje padajoče (najnovejše zgoraj), obrat pa je tu in
   ne v podatkih: zgodovina.json ostane urejen naraščajoče, ker ga bere
   tudi naslovnica in ker bi obrnjen vir zavajal urednika ob dopisovanju.
   Obrne se troje — ere, leta znotraj ere in dosežki znotraj ere. Dodelitve
   fotografij obrat ne zadeva: eraFotografije bere leto in napis, ne
   položaja v seznamu.

   Aktualna era je zadnja v izvornem zaporedju; zastavice v podatkih ne
   beremo, ker bi ob menjavi dirigenta ostala pri starem. */
const obdobjaVir = zgodovinaData.obdobja as Obdobje[];
const obdobja = obdobjaVir
  .map((o, i) => ({
    ...o,
    aktualna: i === obdobjaVir.length - 1,
    obdobjePrikaz: v(o.obdobje, o.obdobjeEn),
    vlogaPrikaz: v(o.vloga, o.vlogaEn),
    opisPrikaz: v(o.opis, o.opisEn),
    vnosiPrikaz: o.vnosi
      .map((x) => ({ leto: x.leto, besedilo: v(x.besedilo, x.besediloEn) }))
      .reverse(),
    fotke: fotografijeEre(o.id as EraId),
  }))
  .reverse();

/* Vrstica sidr pod uvodom. Oznaka je priimek dirigenta, pri ponovljenem
   priimku pa priimek z obdobjem — sicer bi bili Kotarjevi eri v vrstici
   nerazločljivi. Oboje bere ista polja kot naslovi odsekov, zato se
   zapisa ne moreta raziti. */
function priimek(ime: string): string {
  const deli = ime.trim().split(' ').filter(Boolean);
  return deli[deli.length - 1];
}
const kolikokrat = new Map<string, number>();
for (const o of obdobjaVir) {
  const p = priimek(o.vodstvo);
  kolikokrat.set(p, (kolikokrat.get(p) ?? 0) + 1);
}
const navigacija = [
  { sidro: 'era-jubilej', oznaka: '2027' },
  ...obdobja.map((o) => {
    const p = priimek(o.vodstvo);
    return {
      sidro: `era-${o.id}`,
      oznaka: (kolikokrat.get(p) ?? 0) > 1 ? `${p} ${o.obdobjePrikaz}` : p,
    };
  }),
];
---

<Layout
  stran="zgodovina"
  jezik={jezik}
  title={t.zgodovinaStran.naslovStrani}
  description={t.zgodovinaStran.opisStrani}
>
  <Nav stran="zgodovina" jezik={jezik} />

  <main class="stran">
    <div class="ovoj">
      <p class="nazaj"><a href={pot('naslovnica', jezik)}>{t.skupno.nazaj}</a></p>
      <p class="nadnaslov">{t.zgodovinaStran.nadnaslov}</p>
      <h1>{t.zgodovinaStran.naslov}</h1>
      <p class="uvod">{predstavitev}</p>
      <p class="smer">{uvodSmer}</p>

      {/* Oznaka je vidna in hkrati ime navigacije; vidni izvod je skrit
          dostopnosti, da bralnik iste besede ne prebere dvakrat. Sidra
          kažejo na odseke, ne na naslove — scroll-padding-top v brand.css
          poskrbi, da cilj ne pade pod lepljivo navigacijo. */}
      <nav class="smer-nav" aria-label={t.zgodovinaStran.naviNaslov}>
        <span class="smer-nav__oznaka" aria-hidden="true">{t.zgodovinaStran.naviNaslov}</span>
        <ul class="smer-nav__seznam">
          {navigacija.map((n) => (
            <li><a href={`#${n.sidro}`}>{n.oznaka}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    {/* 2027 ni zgodovina, ampak napoved: v padajočem redu stoji na vrhu,
        loči pa ga črtkana obroba in značka. Projekt je pod embargom —
        samo napovednik, brez imen gostov, podrobnosti in finančnih
        podatkov. Pravilo je v CLAUDE.md. */}
    <section class="obdobje" id="era-jubilej" aria-labelledby="obdobje-jubilej">
      <div class="ovoj">
        <div class="napoved">
          <p class="obdobje__leta">
            2027
            <span class="obdobje__znacka">{t.zgodovinaStran.napovedZnacka}</span>
          </p>
          <h2 id="obdobje-jubilej" class="obdobje__naslov">{t.zgodovinaStran.jubilejNaslov}</h2>
          <p class="obdobje__opis obdobje__opis--sam">{jubilej}</p>
        </div>
      </div>
    </section>

    {obdobja.map((o) => (
      <section class="obdobje" id={`era-${o.id}`} aria-labelledby={`obdobje-${o.id}`}>
        <div class="ovoj">
          <p class="obdobje__leta">
            {o.obdobjePrikaz}
            {/* Ista značka kot v časovnici na naslovnici, zato tudi isti
                niz slovarja — dva zapisa iste besede bi se lahko razšla. */}
            {o.aktualna && (
              <span class="obdobje__znacka">{t.zgodovinaSekcija.aktualno}</span>
            )}
          </p>
          <h2 id={`obdobje-${o.id}`} class="obdobje__naslov">{o.vodstvo}</h2>
          <p class="obdobje__vloga">{o.vlogaPrikaz}</p>
          <p class="obdobje__opis">{o.opisPrikaz}</p>

          {/* ul in ne ol: leta tečejo padajoče, zato bi zaporedne številke
              1, 2, 3 … trdile obratno od tega, kar bralec vidi. Zlata pika
              in spojnica ostajata — časovnico nosita ti, ne števci. */}
          <ul class="vnosi">
            {o.vnosiPrikaz.map((v) => (
              <li class="vnos">
                <p class="vnos__leto">{v.leto}</p>
                <p class="vnos__besedilo">{v.besedilo}</p>
              </li>
            ))}
          </ul>

          {o.fotke.length > 0 && (
            <ul class="slike">
              {o.fotke.map((f) => <GalerijaSlika foto={f} jezik={jezik} />)}
            </ul>
          )}
        </div>
      </section>
    ))}

    <div class="ovoj">
      <div class="panel bbg-mikro-desno">
        <h2 class="panel__naslov">{t.zgodovinaStran.gostujociNaslov}</h2>
        <p class="panel__besedilo">{gostujociDirigenti.join(' · ')}</p>
      </div>

      <p class="kredit">{t.zgodovinaStran.kredit}</p>
    </div>
  </main>

  <Noga jezik={jezik} />
  <Lightbox jezik={jezik} />
</Layout>

<style>
  .stran { padding: 52px 0 20px; }
  h1 {
    margin: 10px 0 18px;
    font-size: clamp(28px, 4.4vw, 44px);
    color: var(--bbg-naslov);
  }
  .uvod {
    margin: 0;
    max-width: 46rem;
    opacity: 0.9;
  }
  /* Stavek o smeri branja. Polna moč barve in ležeči rez: navodilo mora
     biti berljivo, umirja ga oblika in ne kontrast. */
  .smer {
    margin: 14px 0 0;
    max-width: 46rem;
    font-style: italic;
    color: var(--bbg-besedilo);
  }

  /* --- Vrstica sidr po erah --- */
  .smer-nav {
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .smer-nav__oznaka {
    font-family: var(--bbg-font-naslov);
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bbg-nadnaslov);
  }
  .smer-nav__seznam {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 6px;
  }
  /* Ločilo je pseudoelement in ne znak v besedilu: v besedilnem toku bi
     pika postala del napisa povezave.

     ::after za vsakim razen zadnjim in ne ::before pred vsakim razen
     prvim: vrstica se pod približno 560 px prelomi v dve, pri ::before pa
     je pika obvisela na začetku druge vrstice, kar je videti kot napaka.
     Zdaj obvisi na koncu prve, kjer se bere kot znak, da se nadaljuje.
     Rešitev ni vezana na prelomno točko, zato zdrži tudi, če se oznake
     podaljšajo ali era doda.

     Delež 66 % in ne 55 %: pri 55 % je pika v obeh svetlih temah dosegla
     le 3,89 : 1 oziroma 3,91 : 1. V temnih temah višji delež kontrast le
     poveča, ker se meša proti svetlemu besedilu. */
  .smer-nav__seznam li:not(:last-child)::after {
    content: '·';
    margin: 0 9px;
    color: color-mix(in srgb, var(--bbg-besedilo) 66%, var(--bbg-bg));
  }
  .smer-nav a,
  .smer-nav a:link,
  .smer-nav a:visited {
    font-size: 14.5px;
    color: var(--bbg-povezava);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--bbg-povezava) 45%, transparent);
  }
  .smer-nav a:hover,
  .smer-nav a:focus-visible {
    color: var(--bbg-povezava-hover);
    border-bottom-color: var(--bbg-povezava-hover);
  }

  /* --- Obdobje --- */
  .obdobje {
    padding: 46px 0 0;
    margin-top: 46px;
    border-top: 1px solid var(--bbg-obroba);
  }
  .obdobje__leta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--bbg-font-naslov);
    letter-spacing: 0.16em;
    font-size: 13px;
    color: var(--bbg-nadnaslov);
  }
  /* Značka "aktualno" oz. "napoved". Enak videz kot v časovnici na
     naslovnici; besedilo v polni barvi, obroba je nosilec poudarka. */
  .obdobje__znacka {
    padding: 2px 10px;
    font-family: var(--bbg-font-besedilo);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bbg-besedilo);
    border: 1px solid color-mix(in srgb, var(--bbg-gold) 55%, transparent);
    border-radius: 999px;
  }
  /* Napoved 2027: črtkana obroba jo loči od zaključenih obdobij, ki jih
     riše navpična os. Panel ima svojo podlago, zato je zlato besedilo v
     svetli temi izmerjeno prav na njej (glej docs/design/README.md). */
  .napoved {
    max-width: 46rem;
    padding: 24px 26px;
    border: 1px dashed color-mix(in srgb, var(--bbg-gold) 55%, transparent);
    border-radius: var(--bbg-r-l);
    background: var(--bbg-panel-bg);
  }
  .napoved .obdobje__naslov { margin-bottom: 8px; }
  /* Mikrorotacija naslova po mockupu smer-c.html, kot pri .sekcija h2. */
  .obdobje__naslov {
    margin: 8px 0 4px;
    font-size: clamp(24px, 3.2vw, 34px);
    color: var(--bbg-naslov);
    transform: rotate(-0.6deg);
    transform-origin: left center;
  }
  .obdobje__vloga {
    margin: 0 0 18px;
    font-style: italic;
    font-size: 15px;
    opacity: 0.75;
  }
  .obdobje__opis {
    margin: 0 0 30px;
    max-width: 46rem;
  }
  .obdobje__opis--sam { margin-bottom: 0; }

  /* --- Vnosi časovnice ---
     Osi ne rišemo prek celotnega seznama: zadnji vnos je visok več vrstic,
     zato bi pod njegovo piko ostal rep. Namesto tega vsak vnos razen zadnjega
     nariše spojnico do naslednje pike. */
  .vnosi {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vnos {
    position: relative;
    padding: 0 0 26px 34px;
  }
  .vnos:last-child { padding-bottom: 0; }
  .vnos::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--bbg-gold);
  }
  /* Od spodnjega roba pike (7 + 15) do zgornjega roba naslednje, ki leži
     7 px pod dnom tega vnosa. Barva sledi temi prek --bbg-gold. */
  .vnos:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 22px;
    bottom: -7px;
    left: 6px;
    width: 3px;
    background: color-mix(in srgb, var(--bbg-gold) 40%, transparent);
  }
  .vnos__leto {
    margin: 0 0 4px;
    font-family: var(--bbg-font-naslov);
    font-size: 17px;
    color: var(--bbg-naslov);
  }
  .vnos__besedilo {
    margin: 0;
    max-width: 46rem;
    font-size: 16px;
  }

  /* --- Fotografije obdobja ---
     Do treh kolon: vsak stolpec je široko vsaj 28 % vsebnika, zato se v
     vrsto ne more uvrstiti četrti, ne glede na širino zaslona. 14rem je
     spodnja meja, da se na ozkem zaslonu mreža zloži v en stolpec.
     Slike dveh er se v isto vrsto ne morejo pomešati, ker ima vsaka era
     svojo mrežo znotraj svojega odseka. Pokončne slike obreže
     GalerijaSlika enako kot v galeriji. */
  .slike {
    list-style: none;
    margin: 34px 0 0;
    padding: 0;
    display: grid;
    gap: 26px;
    grid-template-columns: repeat(auto-fill, minmax(max(28%, 14rem), 1fr));
  }

  /* --- Gostujoči dirigenti --- */
  .panel {
    margin-top: 52px;
    border: 2.5px solid var(--bbg-obroba-mocna);
    border-radius: var(--bbg-r-l);
    padding: 30px 32px;
    background: var(--bbg-panel-bg);
  }
  .panel__naslov {
    margin: 0 0 10px;
    font-size: 22px;
    color: var(--bbg-naslov);
  }
  /* Panel je mikrozarotiran, daljše besedilo v njem ostane ravno. */
  .panel__besedilo {
    margin: 0;
    transform: rotate(-0.5deg);
  }

  .kredit {
    margin: 52px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--bbg-border-dark);
    font-size: 12.5px;
    line-height: 1.7;
    opacity: 0.65;
    max-width: 46rem;
  }

  /* --- Predogled smeri A: brez nagibov, tanjša obroba panela --- */
  :global(:root[data-skin='a']) .obdobje__naslov { transform: none; }
  :global(:root[data-skin='a']) .panel__besedilo { transform: none; }
  :global(:root[data-skin='a']) .panel {
    border-width: 1px;
    border-color: color-mix(in srgb, var(--bbg-gold) 25%, transparent);
  }

  @media (max-width: 620px) {
    .vnos { padding-left: 28px; }
  }
</style>
