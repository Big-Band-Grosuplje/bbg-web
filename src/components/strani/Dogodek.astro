---
/* ============================================================
   Podstran posameznega dogodka.

   Vsebina je isti zapis kot na kartici, le v polni obliki: značke, datum,
   ura, prizorišče, celoten opis, gostje in gumb glede na vrsto vstopa.
   Datumsko oblikovanje in JSON-LD prideta iz src/lib/koncerti.ts — ista
   koda kot na naslovnici, da se zapisa ne moreta raziti.

   Pretekli dogodki se NE brišejo: povezave v arhivih, objavah in e-pošti
   morajo ostati žive. Namesto brisanja dobi stran diskretno oznako.
   ============================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Noga from '../Noga.astro';
import Deljenje from '../Deljenje.astro';
import { pot, slovar, type Jezik } from '../../i18n';
import {
  oznakaZasedbe,
  pripravi,
  type Koncert,
  type OznakeZasedb,
} from '../../lib/koncerti';

interface Props {
  koncert: Koncert;
  jezik: Jezik;
}
const { koncert, jezik } = Astro.props;
const t = slovar(jezik);

const OZNAKE_ZASEDB: OznakeZasedb = {
  'big-band': t.koncerti.zasedbaBigBand,
  combo: t.koncerti.zasedbaCombo,
  mladinski: t.koncerti.zasedbaMladinski,
  izobrazevalni: t.koncerti.zasedbaIzobrazevalni,
};

const SITE_URL = Astro.site ?? new URL('https://bigband-grosuplje.com');
const potSl = `/dogodki/${koncert.slug}/`;
const potEn = `/en/events/${koncert.slugEn}/`;
const potTe = jezik === 'en' ? potEn : potSl;
const absolutni = new URL(potTe, SITE_URL).href;

const k = pripravi(
  koncert,
  jezik,
  { ob: t.koncerti.ob, brezPrizorisca: t.koncerti.brezPrizorisca },
  absolutni,
);

const naslovStrani = `${k.nazivPrikaz} — Big Band Grosuplje`;

/* Zaprtega dogodka ne delimo in ne damo v indeks. Podstran ostane —
   povabljeni pridejo nanjo po neposredni povezavi — le gumba za deljenje
   ni, ker bi javno deljenje vabilo ljudi na dogodek, kamor ne morejo,
   in strani ni v sitemapu (izločitev je v astro.config.mjs). */
const jeZaprt = k.vstop.tip === 'zaprt';
const seDeli = !jeZaprt;
const imaAkcije =
  seDeli ||
  (k.prijava && !k.jeMimo) ||
  (k.vstop.tip === 'vstopnice' && !!k.vstop.url && !k.jeMimo);
---

<Layout
  stran="naslovnica"
  jezik={jezik}
  title={naslovStrani}
  description={k.opisSeoPrikaz}
  potiRazlicic={{ sl: potSl, en: potEn }}
  noindex={jeZaprt}
>
  <Nav stran="naslovnica" jezik={jezik} />

  <main class="stran">
    <div class="ozko">
      <p class="nazaj">
        <a href={`${pot('naslovnica', jezik)}#koncerti`}>{t.koncerti.vsiKoncerti}</a>
      </p>

      {k.jeMimo && <p class="mimo">{t.koncerti.mimo}</p>}

      <h1>{k.nazivPrikaz}</h1>

      <p class="dogodek__meta">
        {k.datumPrikaz}
        {k.lokacija ? ` · ${k.lokacijaPrikaz}` : ` · ${t.koncerti.brezPrizorisca}`}
      </p>

      <p class="dogodek__znacke">
        <span class="znacka">{oznakaZasedbe(k.zasedba, OZNAKE_ZASEDB)}</span>
        {k.vstop.tip === 'prost' && <span class="znacka">{t.koncerti.vstopProst}</span>}
        {k.vstop.tip === 'zaprt' && (
          <span class="znacka znacka--zaprt">{t.koncerti.vstopZaprt}</span>
        )}
        {k.prijava && <span class="znacka__opomba">{t.koncerti.prijavaObvezna}</span>}
      </p>

      <p class="dogodek__opis">{k.opisPrikaz}</p>

      {k.gostje.length > 0 && (
        <p class="dogodek__gostje">
          <span class="oznaka">{t.koncerti.gostje}</span>
          {k.gostje.map((g) => g.naziv).join(', ')}
        </p>
      )}

      {/* Organizator se izpiše samo pri dogodku, ki ga organizira kdo drug;
          pri lastnem dogodku vrstice ni. Povezava je zunanja.

          hreflang in pripis o jeziku sta vpisana ročno, ker vse tri
          obstoječe zunanje povezave vodijo na slovenske strani; polja za
          jezik cilja model nima. Ob dodajanju povezave na stran v drugem
          jeziku ju je treba ali odstraniti ali uvesti polje. */}
      {k.organizatorPrikaz && (
        <p class="dogodek__organizator">
          <span class="oznaka">{t.koncerti.organizator}</span>
          {k.organizatorPrikaz.url ? (
            <a
              href={k.organizatorPrikaz.url}
              hreflang={jezik === 'en' ? 'sl' : undefined}
              target="_blank"
              rel="noopener noreferrer"
              >{k.organizatorPrikaz.naziv}{t.koncerti.vSlovenscini}</a>
          ) : (
            k.organizatorPrikaz.naziv
          )}
        </p>
      )}

      {imaAkcije && (
        <div class="dogodek__akcije">
          {k.prijava && !k.jeMimo && (
            <a class="bbg-gumb" href={`${pot('naslovnica', jezik)}?prijava=delavnica#kontakt`}
              >{t.koncerti.prijavaGumb}</a>
          )}
          {k.vstop.tip === 'vstopnice' && k.vstop.url && !k.jeMimo && (
            <a
              class="bbg-gumb"
              href={k.vstop.url}
              target="_blank"
              rel="noopener noreferrer">{t.koncerti.vstopnice}</a
            >
          )}
          {seDeli && (
            <Deljenje
              jezik={jezik}
              url={absolutni}
              naslov={k.nazivPrikaz}
              opis={k.opisSeoPrikaz}
            />
          )}
        </div>
      )}

      {/* Zunanje objave o dogodku. Stojijo za gumbi, da ne tekmujejo s
          prijavo oziroma vstopnicami, in samo tu — na kartici naslovnice
          bi vodile stran od dogodka, še preden bi ga obiskovalec odprl. */}
      {k.objavePrikaz.length > 0 && (
        <div class="dogodek__objave">
          <p class="dogodek__objaveNaslov">{t.koncerti.objave}</p>
          <ul>
            {k.objavePrikaz.map((o) => (
              <li>
                <a
                  href={o.url}
                  hreflang={jezik === 'en' ? 'sl' : undefined}
                  target="_blank"
                  rel="noopener noreferrer">{o.naziv}{t.koncerti.vSlovenscini}</a
                >
              </li>
            ))}
          </ul>
        </div>
      )}

      {k.jsonLd && <script type="application/ld+json" set:html={JSON.stringify(k.jsonLd)} />}
    </div>
  </main>

  <Noga jezik={jezik} />
</Layout>

<style>
  .ozko {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 var(--bbg-rob);
  }
  .stran { padding: 52px 0 80px; }
  .nazaj { margin: 0 0 26px; font-size: 14px; font-weight: 600; }

  /* Diskretna oznaka preteklega dogodka — ni opozorilo, samo pojasnilo,
     zato brez akcentne barve. */
  .mimo {
    display: inline-block;
    margin: 0 0 14px;
    padding: 4px 12px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bbg-besedilo);
    border: 1px solid color-mix(in srgb, var(--bbg-besedilo) 30%, transparent);
    border-radius: 999px;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(26px, 3.8vw, 40px);
    color: var(--bbg-naslov);
  }
  .dogodek__meta {
    margin: 0 0 18px;
    color: var(--bbg-nadnaslov);
    font-weight: 600;
    font-size: 15.5px;
  }

  .dogodek__znacke {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
  }
  /* Enak slog kot na kartici, le da tu podlaga ni kartica, ampak stran. */
  .znacka {
    display: inline-block;
    padding: 4px 11px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bbg-besedilo);
    border: 1px solid color-mix(in srgb, var(--bbg-gold) 55%, transparent);
    border-radius: 999px;
  }
  .znacka--zaprt {
    border-color: color-mix(in srgb, var(--bbg-besedilo) 30%, transparent);
  }
  .znacka__opomba {
    font-size: 12px;
    font-style: italic;
    color: var(--bbg-besedilo);
  }

  .dogodek__opis { margin: 0 0 20px; }
  .dogodek__gostje { margin: 0 0 8px; font-size: 15px; }
  .dogodek__organizator { margin: 0 0 8px; font-size: 15px; }
  /* Zadnja vrstica dejstev nosi odmik do gumbov; ker je odvisna od tega,
     kaj je vpisano, ga da splošno pravilo za zadnjega sorojenca. */
  .dogodek__gostje:last-of-type,
  .dogodek__organizator:last-of-type { margin-bottom: 30px; }

  /* Enaka vrstica kot na kartici: gumb, desno od njega deljenje, prelom na
     ozkih zaslonih, navpično po sredini. Vsebnik je <div>, ker Deljenje
     izpiše <div> — v <p> bi razčlenjevalnik vrstico razbil. */
  .dogodek__akcije {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
  }

  .dogodek__objave { margin: 34px 0 0; }
  .dogodek__objaveNaslov {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* Sekundarno besedilo brez opacity — ta bi potegnila tudi povezave
       v istem poddrevesu pod AA. */
    color: color-mix(in srgb, var(--bbg-besedilo) 78%, var(--bbg-bg));
  }
  .dogodek__objave ul {
    margin: 0;
    padding: 0 0 0 1.1em;
    font-size: 15px;
  }
  .dogodek__objave li { margin: 0 0 5px; }
</style>
