---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Noga from '../Noga.astro';
import Lightbox from '../Lightbox.astro';
import VideoModal from '../VideoModal.astro';
import Posnetek from '../Posnetek.astro';
import GalerijaSlika from '../GalerijaSlika.astro';
import znakZlat from '../../assets/brand/bbg-znak-zlat.svg';
import fotoHero from '../../assets/foto/orkester/kotar-dirigent-energija.jpg';
/* Hero smeri A — glej docs/design/README.md. */
import fotoHeroA from '../../assets/foto/hero/hero-kazina-zlati-napis-2026.jpg';
import koncertiData from '../../data/koncerti.json';
import zgodovinaData from '../../data/zgodovina.json';
import { najnovejse } from '../../lib/galerija';
import { najnovejsi } from '../../lib/mediji';
import { WEB3FORMS_KEY, KONTAKT_EPOSTA } from '../../config';
import { pot, slovar, type Jezik } from '../../i18n';

interface Props {
  jezik: Jezik;
}
const { jezik } = Astro.props;
const t = slovar(jezik);
const en = jezik === 'en';

/* Oblika datuma sledi jeziku: sl-SI da "18. 9. 2026", en-GB pa
   "18 September 2026". Trdi podatek (datumIso) je isti. */
const LOKALA = en ? 'en-GB' : 'sl-SI';

const SITE = 'https://bigband-grosuplje.com';

const KANALI = {
  facebook: 'https://www.facebook.com/BigBandGrosuplje',
  instagram: 'https://www.instagram.com/bigbandgrosuplje/',
};

type Gost = { naziv: string; tip: string | null };
type Lokacija = {
  naziv: string;
  nazivEn?: string;
  ulica?: string | null;
  postna?: string | null;
  kraj: string;
  drzava?: string | null;
} | null;
type Koncert = {
  id: string;
  naziv: string;
  nazivEn?: string;
  opis: string;
  opisEn?: string;
  opisSeo?: string;
  opisSeoEn?: string;
  datumOpisEn?: string;
  gostje: Gost[];
  datumIso: string | null;
  ura: string | null;
  datumOpis: string;
  lokacija: Lokacija;
  zasedba: 'big-band' | 'combo' | 'mladinski' | 'izobrazevalni';
  vstop: { tip: 'vstopnice' | 'prost' | 'zaprt'; url?: string | null };
};

const koncerti = koncertiData.koncerti as Koncert[];

/* Prizorišče za meta vrstico. Ime prizorišča kraj pogosto že vsebuje
   ("Rezidenca ameriškega veleposlaništva, Ljubljana"), zato ga ne
   pripenjamo dvakrat — brez te preverbe je v vrstici pisalo
   "…, Ljubljana, Ljubljana". V JSON-LD ostaneta ime in addressLocality
   ločena, tam podvojitve ni. */
function krajZaPrikaz(lokacija: NonNullable<Lokacija>, en: boolean): string {
  const naziv = en ? (lokacija.nazivEn ?? lokacija.naziv) : lokacija.naziv;
  const kraj = lokacija.kraj;
  return naziv.includes(kraj) ? naziv : `${naziv}, ${kraj}`;
}

/* Značke na kartici. Oznaka zasedbe pride iz slovarja po ključu iz podatkov;
   če bi se v podatkih pojavila neznana zasedba, naj build pade in ne tiho
   izpiše prazne značke. */
const OZNAKA_ZASEDBE: Record<Koncert['zasedba'], string> = {
  'big-band': t.koncerti.zasedbaBigBand,
  combo: t.koncerti.zasedbaCombo,
  mladinski: t.koncerti.zasedbaMladinski,
  izobrazevalni: t.koncerti.zasedbaIzobrazevalni,
};
function oznakaZasedbe(zasedba: Koncert['zasedba']): string {
  const o = OZNAKA_ZASEDBE[zasedba];
  if (!o) throw new Error(`Neznana zasedba v koncerti.json: ${zasedba}`);
  return o;
}

/* Datum v sl-SI zapisu: polni datum kot d. M. yyyy, sam mesec kot "oktober 2026".
   Ob znani uri se doda "ob 19.00" (slovenski zapis ure s piko). */
function formatDatum(datumIso: string | null, ura: string | null): string | null {
  if (!datumIso) return null;
  if (/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) {
    const datum = new Intl.DateTimeFormat(LOKALA, {
      day: 'numeric',
      month: en ? 'long' : 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(datumIso + 'T00:00:00Z'));
    /* Slovenski zapis ure je s piko, angleški z dvopičjem. */
    const zapisUre = en ? ura : ura?.replace(':', '.');
    return ura ? `${datum} ${t.koncerti.ob} ${zapisUre}` : datum;
  }
  if (/^\d{4}-\d{2}$/.test(datumIso)) {
    return new Intl.DateTimeFormat(LOKALA, {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(datumIso + '-01T00:00:00Z'));
  }
  return null;
}

/* Datum razstavljen za temni blok na kartici: dan, mesec, leto ločeno. */
function datumBlok(datumIso: string | null) {
  if (!datumIso || !/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) return null;
  const d = new Date(datumIso + 'T00:00:00Z');
  return {
    dan: new Intl.DateTimeFormat(LOKALA, { day: 'numeric', timeZone: 'UTC' }).format(d),
    mesec: new Intl.DateTimeFormat(LOKALA, { month: 'short', timeZone: 'UTC' }).format(d),
    leto: new Intl.DateTimeFormat(LOKALA, { year: 'numeric', timeZone: 'UTC' }).format(d),
  };
}

/* Prihajajoč = brez znanega datuma (napovedan, a še ne uvrščen) ali datum v prihodnosti.
   Filtriranje se izvede ob buildu — po preteku koncerta je potrebna nova objava. */
function jePrihajajoc(datumIso: string | null): boolean {
  if (!datumIso) return true;
  const danes = new Date();
  danes.setUTCHours(0, 0, 0, 0);
  if (/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) {
    return new Date(datumIso + 'T00:00:00Z') >= danes;
  }
  if (/^\d{4}-\d{2}$/.test(datumIso)) {
    const [leto, mesec] = datumIso.split('-').map(Number);
    return new Date(Date.UTC(leto, mesec, 0)) >= danes;
  }
  return true;
}

/* Časovni odmik za Europe/Ljubljana ob danem trenutku — septembra CEST (+02:00),
   decembra CET (+01:00). Odmika ne zapisujemo v podatke, ker se z datumom spreminja. */
function odmikLjubljana(datumIso: string, ura: string): string {
  const priblizek = new Date(`${datumIso}T${ura}:00Z`);
  const zapis = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Ljubljana',
    timeZoneName: 'longOffset',
  })
    .formatToParts(priblizek)
    .find((del) => del.type === 'timeZoneName')?.value;
  const odmik = (zapis ?? '').replace('GMT', '');
  return odmik === '' ? 'Z' : odmik;
}

/* startDate po ISO 8601: z uro vključno s časovnim odmikom, brez ure samo datum. */
function startDate(datumIso: string, ura: string | null): string {
  if (!ura || !/^\d{4}-\d{2}-\d{2}$/.test(datumIso)) return datumIso;
  return `${datumIso}T${ura}:00${odmikLjubljana(datumIso, ura)}`;
}

/* JSON-LD nastane samo, če sta znana datum in lokacija — nepopoln MusicEvent
   je za iskalnike slabši od nobenega. Za description uporabimo nevtralni
   opisSeo, ne duhovitega besedila s kartice. */
function musicEvent(k: Koncert) {
  if (!k.datumIso || !k.lokacija) return null;
  const izvajalci: Record<string, string>[] = [
    { '@type': 'MusicGroup', name: 'Big Band Grosuplje', url: SITE },
  ];
  for (const gost of k.gostje) {
    if (gost.tip) izvajalci.push({ '@type': gost.tip, name: gost.naziv });
  }
  const dogodek: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'MusicEvent',
    name: en ? (k.nazivEn ?? k.naziv) : k.naziv,
    description: en ? (k.opisSeoEn ?? k.opisEn ?? k.opis) : (k.opisSeo ?? k.opis),
    startDate: startDate(k.datumIso, k.ura),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    performer: izvajalci,
    organizer: {
      '@type': 'Organization',
      name: 'Kulturno društvo Big Band Grosuplje',
      url: SITE,
    },
    location: {
      '@type': 'Place',
      name: en ? (k.lokacija.nazivEn ?? k.lokacija.naziv) : k.lokacija.naziv,
      address: {
        '@type': 'PostalAddress',
        ...(k.lokacija.ulica ? { streetAddress: k.lokacija.ulica } : {}),
        ...(k.lokacija.postna ? { postalCode: k.lokacija.postna } : {}),
        addressLocality: k.lokacija.kraj,
        addressCountry: k.lokacija.drzava ?? 'SI',
      },
    },
  };
  /* offers po vrsti vstopa:
     - prost: cena 0 EUR, da iskalniki brezplačen dogodek prepoznajo kot tak;
     - vstopnice z znanim URL: ponudba s povezavo;
     - vstopnice brez URL (še ni v prodaji) in zaprt dogodek: offers
       izpustimo — nepopolna ponudba je za iskalnike slabša od nobene.
     eventAttendanceMode ostane v vseh primerih, ker se vrsta vstopa ne
     tiče tega, ali je dogodek v živo. */
  if (k.vstop.tip === 'prost') {
    dogodek.offers = {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
    };
  } else if (k.vstop.tip === 'vstopnice' && k.vstop.url) {
    dogodek.offers = {
      '@type': 'Offer',
      url: k.vstop.url,
      availability: 'https://schema.org/InStock',
    };
  }
  return dogodek;
}

const prihajajoci = koncerti
  .filter((k) => jePrihajajoc(k.datumIso))
  .map((k) => ({
    ...k,
    nazivPrikaz: en ? (k.nazivEn ?? k.naziv) : k.naziv,
    opisPrikaz: en ? (k.opisEn ?? k.opis) : k.opis,
    lokacijaPrikaz: k.lokacija ? krajZaPrikaz(k.lokacija, en) : null,
    datumPrikaz:
      formatDatum(k.datumIso, k.ura) ?? (en ? (k.datumOpisEn ?? k.datumOpis) : k.datumOpis),
    blok: datumBlok(k.datumIso),
    jsonLd: musicEvent(k),
  }));

/* Izseki na naslovnici — celotna vsebina je na podstranih. */
const posnetkiIzsek = najnovejsi(3);
const fotografijeIzsek = najnovejse(6);
const predstavitev = en
  ? (zgodovinaData.predstavitevEn ?? zgodovinaData.predstavitev)
  : zgodovinaData.predstavitev;
const mejniki = (
  zgodovinaData.mejniki as {
    leto: string;
    naslov: string;
    besedilo: string;
    naslovEn?: string;
    besediloEn?: string;
  }[]
).map((m) => ({
  leto: m.leto,
  naslov: en ? (m.naslovEn ?? m.naslov) : m.naslov,
  besedilo: en ? (m.besediloEn ?? m.besedilo) : m.besedilo,
}));

const web3formsVklopljen = WEB3FORMS_KEY !== '';

/* Hero smeri A je fullbleed CSS ozadje, ne <img>. Razlog za ozadje: skrit
   <img> Chrome prenese tudi z loading="lazy" (display:none nima okvira,
   zato odložitev odpade), s čimer bi privzeti skin C plačal ves ta KB po
   nepotrebnem. Ozadje v var(--hero-a) se ne zahteva, dokler pravilo ne
   velja — izmerjeno z resource timingom.
   Širina 1920: fotografija pokriva celotno širino zaslona, zato je 900 px
   premalo. Cena je samo v buildu, ker se pri skin=c ne prenese.
   Cena za A: brez srcset. */
const heroA = await getImage({ src: fotoHeroA, width: 1920, format: 'webp' });
---

<Layout
  stran="naslovnica"
  jezik={jezik}
  title={t.naslovnica.naslovStrani}
  description={t.naslovnica.opisStrani}
>
  <Nav stran="naslovnica" jezik={jezik} />

  {/* --hero-a nosi <main>, ker je pri smeri A fotografija ozadje celotnega
      heroja. Pri skin=c je spremenljivka neuporabljena in se ne prenese. */}
  <main class="hero" style={`--hero-a: url('${heroA.src}');`}>
    <div class="ovoj hero__mreza">
      <div class="hero__besedilo">
        <p class="bbg-badge bbg-rot-badge hero__badge">{t.hero.badge}</p>
        <img
          src={znakZlat.src}
          alt={t.hero.znakAlt}
          class="hero__znak bbg-rot-znak"
          width="420"
        />
        <p class="hero__slogan">{t.hero.slogan}</p>
        <p class="hero__gumbi">
          <a href="#koncerti" class="bbg-gumb">{t.hero.gumbKoncerti}</a>
          <a href="#kontakt" class="bbg-gumb bbg-gumb--obris">{t.hero.gumbPridruzi}</a>
        </p>
      </div>

      <div class="hero__foto">
        <Image
          src={fotoHero}
          alt={t.hero.fotoAlt}
          width={900}
          loading="eager"
          class="bbg-rot-foto"
        />
        <span class="hero__nalepka bbg-rot-nalepka">{t.hero.nalepka}</span>
      </div>
    </div>
  </main>

  <section class="sekcija" id="koncerti" aria-labelledby="koncerti-naslov">
    <div class="ovoj">
      <p class="nadnaslov">{t.koncerti.nadnaslov}</p>
      <h2 id="koncerti-naslov">{t.koncerti.naslov}</h2>

      {prihajajoci.length === 0 ? (
        <p class="prazno">
          {t.koncerti.praznoPred}{' '}
          <a href={KANALI.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>{' '}
          {t.koncerti.praznoVez}{' '}
          <a href={KANALI.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>{t.koncerti.praznoZa}
        </p>
      ) : (
        <ul class="kartice">
          {prihajajoci.map((k) => (
            <li class="kartica bbg-mikro-kartica">
              {k.blok ? (
                <p class="kartica__blok">
                  <span class="kartica__dan">{k.blok.dan}</span>
                  <span class="kartica__mesec">{k.blok.mesec}</span>
                  <span class="kartica__leto">{k.blok.leto}</span>
                </p>
              ) : (
                <p class="kartica__blok kartica__blok--brez">
                  <span class="kartica__mesec">{k.datumPrikaz}</span>
                </p>
              )}

              <div class="kartica__telo">
                <h3 class="kartica__naziv">{k.nazivPrikaz}</h3>
                <p class="kartica__meta">
                  {k.datumPrikaz}
                  {k.lokacija
                    ? ` · ${k.lokacijaPrikaz}`
                    : ` · ${t.koncerti.brezPrizorisca}`}
                </p>
                <p class="kartica__znacke">
                  <span class="znacka">{oznakaZasedbe(k.zasedba)}</span>
                  {k.vstop.tip === 'prost' && (
                    <span class="znacka">{t.koncerti.vstopProst}</span>
                  )}
                  {k.vstop.tip === 'zaprt' && (
                    <span class="znacka znacka--zaprt">{t.koncerti.vstopZaprt}</span>
                  )}
                </p>
                <p class="kartica__opis">{k.opisPrikaz}</p>
                {k.gostje.length > 0 && (
                  <p class="kartica__gostje">
                    <span class="oznaka">{t.koncerti.gostje}</span>
                    {k.gostje.map((g) => g.naziv).join(', ')}
                  </p>
                )}
                {/* Gumb samo, kadar je povezava res znana: pri tipu
                    "vstopnice" z url null (prodaja se še ni odprla) gumba
                    ne kažemo. Prodaja je vedno na tuji domeni — novi zavihek. */}
                {k.vstop.tip === 'vstopnice' && k.vstop.url && (
                  <p class="kartica__cta">
                    <a
                      class="bbg-gumb bbg-gumb--mali"
                      href={k.vstop.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >{t.koncerti.vstopnice}</a>
                  </p>
                )}
              </div>

              {k.jsonLd && (
                <script type="application/ld+json" set:html={JSON.stringify(k.jsonLd)} />
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="sekcija" id="zgodovina" aria-labelledby="zgodovina-naslov">
    <div class="ovoj">
      <p class="nadnaslov">{t.zgodovinaSekcija.nadnaslov}</p>
      <h2 id="zgodovina-naslov">{t.zgodovinaSekcija.naslov}</h2>

      <p class="zgodovina__uvod">{predstavitev}</p>

      <ol class="mejniki" style={`--stolpci: ${mejniki.length}`}>
        {mejniki.map((m) => (
          <li class="mejnik">
            <p class="mejnik__leto">{m.leto}</p>
            <h3 class="mejnik__naslov">{m.naslov}</h3>
            <p class="mejnik__opis">{m.besedilo}</p>
          </li>
        ))}
      </ol>

      <p class="vec">
        <a class="bbg-gumb bbg-gumb--obris" href={pot('zgodovina', jezik)}>{t.zgodovinaSekcija.vec}</a>
      </p>
    </div>
  </section>

  <section class="sekcija" id="galerija" aria-labelledby="galerija-naslov">
    <div class="ovoj">
      <p class="nadnaslov">{t.galerijaSekcija.nadnaslov}</p>
      <h2 id="galerija-naslov">{t.galerijaSekcija.naslov}</h2>

      <ul class="slike">
        {fotografijeIzsek.map((f) => <GalerijaSlika foto={f} jezik={jezik} />)}
      </ul>

      <p class="vec">
        <a class="bbg-gumb bbg-gumb--obris" href={pot('galerija', jezik)}>{t.galerijaSekcija.vec}</a>
      </p>
      <p class="galerija__kredit">{t.galerijaSekcija.kredit}</p>
    </div>
  </section>

  <section class="sekcija" id="multimedija" aria-labelledby="mediji-naslov">
    <div class="ovoj">
      <p class="nadnaslov">{t.multimedijaSekcija.nadnaslov}</p>
      <h2 id="mediji-naslov">{t.multimedijaSekcija.naslov}</h2>

      <ul class="posnetki">
        {posnetkiIzsek.map((m) => <Posnetek medij={m} jezik={jezik} />)}
      </ul>

      <p class="vec">
        <a class="bbg-gumb bbg-gumb--obris" href={pot('multimedija', jezik)}>{t.multimedijaSekcija.vec}</a>
      </p>
    </div>
  </section>

  <section class="sekcija" id="kontakt" aria-labelledby="kontakt-naslov">
    <div class="ovoj">
      <p class="nadnaslov">{t.kontakt.nadnaslov}</p>
      <h2 id="kontakt-naslov">{t.kontakt.naslov}</h2>

      <div class="dvostolpca">
        <div class="panel bbg-mikro-levo">
          <h3>{t.kontakt.organizatorNaslov}</h3>
          <p>{t.kontakt.organizatorOpis}</p>

          <form
            class="obrazec"
            data-obrazec="organizator"
            data-w3f-key={WEB3FORMS_KEY}
            data-posiljamo={t.obrazec.posiljamo}
            data-oddano={t.obrazec.oddano}
            data-napaka={t.obrazec.napaka}
            data-nedeluje={t.obrazec.nedeluje}
            action={web3formsVklopljen ? 'https://api.web3forms.com/submit' : undefined}
            method="post"
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value={t.kontakt.organizatorZadeva} />
            <input type="hidden" name="from_name" value="bigband-grosuplje.com" />
            {/* honeypot za robote — človek tega polja ne vidi */}
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <label for="org-ime">{t.kontakt.ime}</label>
            <input id="org-ime" name="ime" type="text" autocomplete="name" required />

            <label for="org-eposta">{t.kontakt.eposta}</label>
            <input id="org-eposta" name="eposta" type="email" autocomplete="email" required />

            <label for="org-sporocilo">{t.kontakt.sporocilo}</label>
            <textarea id="org-sporocilo" name="sporocilo" rows="4" required></textarea>

            <button class="bbg-gumb" type="submit">{t.kontakt.organizatorGumb}</button>
            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
        </div>

        <div class="panel panel--akcent bbg-mikro-desno">
          <h3>{t.kontakt.pridruzitevNaslov}</h3>
          <p>{t.kontakt.pridruzitevOpis}</p>

          <form
            class="obrazec"
            data-obrazec="pridruzitev"
            data-w3f-key={WEB3FORMS_KEY}
            data-posiljamo={t.obrazec.posiljamo}
            data-oddano={t.obrazec.oddano}
            data-napaka={t.obrazec.napaka}
            data-nedeluje={t.obrazec.nedeluje}
            action={web3formsVklopljen ? 'https://api.web3forms.com/submit' : undefined}
            method="post"
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value={t.kontakt.pridruzitevZadeva} />
            <input type="hidden" name="from_name" value="bigband-grosuplje.com" />
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <label for="pri-ime">{t.kontakt.ime}</label>
            <input id="pri-ime" name="ime" type="text" autocomplete="name" required />

            <label for="pri-eposta">{t.kontakt.eposta}</label>
            <input id="pri-eposta" name="eposta" type="email" autocomplete="email" required />

            <label for="pri-podrocje">{t.kontakt.podrocje}</label>
            {/* value ostane slovenski ključ — to je podatek, ki pride k nam
                v e-pošto, ne besedilo za obiskovalca. */}
            <select id="pri-podrocje" name="podrocje" required>
              <option value="instrumentalist">{t.kontakt.podrocjeInstrumentalist}</option>
              <option value="vokalist">{t.kontakt.podrocjeVokalist}</option>
              <option value="tehnicna-podpora">{t.kontakt.podrocjeTehnika}</option>
            </select>

            <label for="pri-sporocilo">{t.kontakt.sporocilo}</label>
            <textarea id="pri-sporocilo" name="sporocilo" rows="4" required></textarea>

            <button class="bbg-gumb bbg-gumb--obris" type="submit">{t.kontakt.pridruzitevGumb}</button>
            <p class="obrazec__stanje" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Noga jezik={jezik} />
  <VideoModal jezik={jezik} />
  <Lightbox jezik={jezik} />
</Layout>

<script>
  /* Kontaktna obrazca: Web3Forms prek fetch, da obiskovalec ostane na strani.
     Telo je FormData — vrsta vsebine multipart/form-data je na seznamu varnih
     za CORS in ne sproži preflighta.

     Kaj je preverjeno (31. 8. 2026) in kaj ne:
     - Web3Forms zavrača strežniške zahteve (curl dobi 403 "Use our API in
       client side"), zato je fetch iz brskalnika edina pot; navadnega POST
       v novem zavihku ne moremo uporabiti kot rezervo.
     - Odziv na NAPAKO nima CORS glav: poskus iz brskalnika z neveljavnim
       ključem konča v catch z "Failed to fetch". Za nas to ni težava —
       napaka je napaka in obiskovalec dobi sporočilo z e-naslovom.
     - Odziva na USPEŠNO oddajo nismo preverili, ker bi za to morali poslati
       pravo sporočilo. Če bi CORS blokiral tudi uspešen odziv, bi sporočilo
       prišlo do nas, obiskovalec pa bi videl napako. Prepoznaš po tem: mail
       prispe, stran javi "Pošiljanje ni uspelo". V tem primeru preklopi na
       navaden POST z target="_blank".

     Ob napaki ponudimo e-naslov, mailto rezerve ni več. */
  const EPOSTA = 'info@bigband-grosuplje.com';

  function stanje(obrazec: HTMLFormElement, sporocilo: string, napaka = false) {
    const polje = obrazec.querySelector<HTMLElement>('.obrazec__stanje');
    if (!polje) return;
    polje.textContent = sporocilo;
    polje.classList.toggle('obrazec__stanje--napaka', napaka);
  }

  document.querySelectorAll<HTMLFormElement>('.obrazec').forEach((obrazec) => {
    obrazec.addEventListener('submit', async (dogodek) => {
      dogodek.preventDefault();
      if (!obrazec.reportValidity()) return;

      const podatki = new FormData(obrazec);
      if (podatki.get('botcheck')) return; /* honeypot */

      /* Brez ključa oddaje ni; obiskovalcu ponudimo naš e-naslov, ne
         odpremo pa mu odjemalca — mailto rezerve v vmesniku ni več. */
      if ((obrazec.dataset.w3fKey ?? '') === '') {
        stanje(obrazec, `${obrazec.dataset.nedeluje} ${EPOSTA}.`, true);
        return;
      }

      stanje(obrazec, obrazec.dataset.posiljamo ?? '');
      try {
        const odziv = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: podatki,
        });
        const izid = await odziv.json();
        if (odziv.ok && izid.success) {
          obrazec.reset();
          stanje(obrazec, obrazec.dataset.oddano ?? '');
        } else {
          stanje(obrazec, `${obrazec.dataset.napaka} ${EPOSTA}.`, true);
        }
      } catch {
        stanje(obrazec, `${obrazec.dataset.napaka} ${EPOSTA}.`, true);
      }
    });
  });
</script>

