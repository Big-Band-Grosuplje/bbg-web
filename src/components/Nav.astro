---
import znakZlat from '../assets/brand/bbg-znak-zlat.svg';
import { drugiJezik, pot, sidro, slovar, type Jezik, type Stran } from '../i18n';

interface Props {
  /* Na naslovnici kažeta Koncerti in Kontakt na sidri, drugod na naslovnico.
     Zgodovina, Multimedija in Galerija vodijo vedno na podstran — tam je
     celotna vsebina, izsek na naslovnici je samo napovednik. */
  stran: Stran;
  jezik: Jezik;
}
const { stran, jezik } = Astro.props;
const t = slovar(jezik);

const koncerti = sidro(stran, jezik, 'koncerti');
const kontakt = sidro(stran, jezik, 'kontakt');

/* Gumb za jezik pelje na isto stran v drugem jeziku — pot pride iz iste
   tabele kot hreflang, zato se ne moreta raziti. */
const drugi = drugiJezik(jezik);
const potDrugega = pot(stran, drugi);
---

{/* Zastavica "stran ima JS", postavljena sinhrono PRED navigacijo, torej pred
    njenim prvim izrisom — brez utripa razgrnjenega menija. Brez nje CSS pusti
    meni razgrnjen in skrije burger, ker ga brez JS nihče ne more odpreti.
    (Enak vzorec kot inline skripta za temo v Layout.astro.) */}
<script is:inline>
  document.documentElement.dataset.js = 'da';
</script>

<nav class="nav" aria-label={t.nav.oznaka} data-meni="zaprt">
  <div class="ovoj nav__vrstica">
    <a href={pot('naslovnica', jezik)} class="nav__znak" aria-label={t.nav.znakAlt}>
      <img src={znakZlat.src} alt="" width="120" class="bbg-rot-znak-nav" />
    </a>

    {/* display: contents na širokem zaslonu — povezave in CTA se postavijo
        neposredno v vrstico, zato vrstni red določa CSS order. Na ožjem
        zaslonu se .nav__meni spremeni v pravi blok pod vrstico. */}
    <div class="nav__meni" id="nav-meni">
      {/* Vrstni red sledi vrstnemu redu sekcij na naslovnici — ob premiku
          sekcije premakni tudi povezavo. */}
      <a href={koncerti}>{t.nav.koncerti}</a>
      <a href={pot('zgodovina', jezik)}>{t.nav.zgodovina}</a>
      <a href={pot('galerija', jezik)}>{t.nav.galerija}</a>
      <a href={pot('multimedija', jezik)}>{t.nav.multimedija}</a>
      <a class="nav__cta" href={kontakt}>{t.nav.cta}</a>
    </div>

    {/* Preklop jezika je navadna povezava, ne gumb: brez JS deluje enako,
        pravi cilj pa je viden v vrstici stanja. Skripta ob kliku samo
        zabeleži izbiro, da samodejna zaznava ne posreduje več. */}
    <a
      class="nav__jezik"
      id="preklop-jezika"
      href={potDrugega}
      hreflang={drugi}
      lang={drugi}
      data-jezik={drugi}
      aria-label={t.nav.jezik}
    >{t.nav.jezikKratko}</a>

    <button
      type="button"
      class="nav__tema"
      id="preklop-teme"
      aria-label={t.nav.tema}
      aria-pressed="false"
    >
      <span class="nav__ikona" aria-hidden="true">☾</span>
    </button>

    <button
      type="button"
      class="nav__burger"
      id="preklop-menija"
      aria-controls="nav-meni"
      aria-expanded="false"
    >
      <span class="nav__crte" aria-hidden="true"></span>
      <span class="vizualno-skrito">{t.nav.meni}</span>
    </button>
  </div>
</nav>

<script>
  /* --- Preklop teme ---
     Začetno stanje postavi inline skripta v <head> (Layout.astro),
     zato tu samo obrnemo in shranimo izbiro. */
  const gumb = document.querySelector<HTMLButtonElement>('#preklop-teme');
  const ikona = gumb?.querySelector<HTMLElement>('.nav__ikona');

  function osvezi(tema: string) {
    if (ikona) ikona.textContent = tema === 'light' ? '☀' : '☾';
    gumb?.setAttribute('aria-pressed', tema === 'light' ? 'true' : 'false');
  }

  osvezi(document.documentElement.dataset.theme ?? 'dark');

  gumb?.addEventListener('click', () => {
    const trenutna = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const nova = trenutna === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = nova;
    try {
      localStorage.setItem('bbg-tema', nova);
    } catch (e) {
      /* zasebni način ipd. — tema deluje do osvežitve strani */
    }
    osvezi(nova);
  });

  /* --- Preklop jezika ---
     Povezavi ob nalaganju pripnemo trenutni query in sidro, da preklop
     ohrani ?skin in mesto na strani; tema je v localStorage in preživi
     sama. Klik zabeleži izbiro, da samodejna zaznava v <head> ne
     posreduje več — od tega trenutka velja obiskovalčeva odločitev. */
  const jezikGumb = document.querySelector<HTMLAnchorElement>('#preklop-jezika');

  if (jezikGumb) {
    const cilj = new URL(jezikGumb.getAttribute('href') ?? '/', window.location.origin);
    cilj.search = window.location.search;
    cilj.hash = window.location.hash;
    jezikGumb.href = cilj.pathname + cilj.search + cilj.hash;

    jezikGumb.addEventListener('click', () => {
      try {
        localStorage.setItem('bbg-lang', jezikGumb.dataset.jezik ?? 'sl');
      } catch (e) {
        /* zasebni način — izbira velja samo za to navigacijo */
      }
    });
  }

  /* --- Burger meni ---
     Stanje nosi data-meni na <nav>, skrivanje pa velja SAMO znotraj
     medijske poizvedbe za ozek zaslon. Zato zaprt meni ob razširitvi
     okna ne more skriti navigacije na širokem zaslonu. */
  const nav = document.querySelector<HTMLElement>('.nav');
  const burger = document.querySelector<HTMLButtonElement>('#preklop-menija');
  const meni = document.querySelector<HTMLElement>('#nav-meni');
  const sirok = window.matchMedia('(min-width: 821px)');

  function nastaviMeni(odprt: boolean) {
    if (!nav || !burger) return;
    nav.dataset.meni = odprt ? 'odprt' : 'zaprt';
    burger.setAttribute('aria-expanded', odprt ? 'true' : 'false');
  }

  burger?.addEventListener('click', () => {
    nastaviMeni(nav?.dataset.meni !== 'odprt');
  });

  /* Klik na povezavo v meniju: pri sidru na isti strani se stran ne naloži
     znova, zato meni zapremo sami. */
  meni?.addEventListener('click', (dogodek) => {
    if ((dogodek.target as HTMLElement).closest('a')) nastaviMeni(false);
  });

  document.addEventListener('keydown', (dogodek) => {
    if (dogodek.key !== 'Escape' || nav?.dataset.meni !== 'odprt') return;
    nastaviMeni(false);
    burger?.focus();
  });

  /* Ob prehodu na širok zaslon meni ni več skrit, zato mora aria-expanded
     nehati trditi nasprotno. */
  sirok.addEventListener('change', (dogodek) => {
    if (dogodek.matches) nastaviMeni(false);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 9;
    background: var(--bbg-nav-bg);
    border-bottom: 3px solid var(--bbg-gold);
  }
  .nav__vrstica {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 12px var(--bbg-rob);
    flex-wrap: wrap;
  }

  /* Vrstni red na širokem zaslonu: znak · povezave · jezik · tema · CTA.
     Odmik na desno nosi prvi element desne skupine, torej gumb za jezik. */
  .nav__znak { order: 1; line-height: 0; }
  .nav__meni { display: contents; }
  .nav__meni a { order: 2; }
  .nav__jezik { order: 3; margin-left: auto; }
  .nav__tema { order: 4; }
  .nav__meni .nav__cta { order: 5; }
  .nav__burger { display: none; }

  /* Preklop jezika: besedilo, ne zastavica — zastavica pomeni državo,
     ne jezika. Oblika sledi gumbu za temo, da desna skupina drži skupaj. */
  .nav .nav__jezik,
  .nav .nav__jezik:link,
  .nav .nav__jezik:visited {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 9px;
    flex: 0 0 auto;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--bbg-nav-povezava);
    text-decoration: none;
    background: transparent;
    border: 2px solid var(--bbg-obroba-mocna);
    border-radius: var(--bbg-r-badge);
  }
  .nav .nav__jezik:hover,
  .nav .nav__jezik:focus-visible { color: var(--bbg-povezava); }
  .nav__jezik:focus-visible {
    outline: 2px solid var(--bbg-obroba-mocna);
    outline-offset: 2px;
  }

  .nav__znak img {
    height: 46px;
    width: auto;
    display: block;
  }
  .nav a,
  .nav a:link,
  .nav a:visited {
    color: var(--bbg-nav-povezava);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
  }
  .nav a:hover,
  .nav a:focus-visible { color: var(--bbg-povezava); }

  .nav__tema {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    font-size: 18px;
    line-height: 1;
    background: transparent;
    color: var(--bbg-nav-povezava);
    border: 2px solid var(--bbg-obroba-mocna);
    border-radius: var(--bbg-r-badge);
    cursor: pointer;
  }
  .nav__tema:hover { color: var(--bbg-povezava); }
  .nav__tema:focus-visible {
    outline: 2px solid var(--bbg-obroba-mocna);
    outline-offset: 2px;
  }

  /* Selektor mora vsebovati .nav, sicer ga premaga pravilo ".nav a:link"
     zgoraj — (0,3,1) proti (0,2,1) — in CTA vzame barvo navadne povezave.
     V svetli temi je to ink na akcentu, kar da 3,35 :1; s papirnatim
     besedilom je 4,90 :1. */
  .nav .nav__cta,
  .nav .nav__cta:link,
  .nav .nav__cta:visited {
    background: var(--bbg-accent);
    color: var(--bbg-paper);
    padding: 9px 20px;
    border-radius: var(--bbg-r-badge);
    /* 600 po mockupu smer-c.html. Prej je tu pisalo 800, a se ni uveljavilo,
       ker je pravilo ".nav a" prevladalo; ob popravku specifičnosti bi se
       nenadoma uveljavilo in CTA razširilo za 8 px. Izris ostane isti. */
    font-weight: 600;
  }
  .nav .nav__cta:hover,
  .nav .nav__cta:focus-visible { color: var(--bbg-paper); }

  /* --- Burger: tri črte iz enega elementa, da ni treba treh praznih span --- */
  .nav__burger {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    background: transparent;
    border: 2px solid var(--bbg-obroba-mocna);
    border-radius: var(--bbg-r-badge);
    cursor: pointer;
    padding: 0;
  }
  .nav__burger:focus-visible {
    outline: 2px solid var(--bbg-obroba-mocna);
    outline-offset: 2px;
  }
  .nav__crte,
  .nav__crte::before,
  .nav__crte::after {
    display: block;
    width: 18px;
    height: 2.5px;
    background: var(--bbg-nav-povezava);
    border-radius: 2px;
  }
  .nav__crte { position: relative; }
  .nav__crte::before,
  .nav__crte::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .nav__crte::before { top: -6px; }
  .nav__crte::after { top: 6px; }
  .nav__burger:hover .nav__crte,
  .nav__burger:hover .nav__crte::before,
  .nav__burger:hover .nav__crte::after { background: var(--bbg-povezava); }

  /* --- Predogled smeri A ---
     Pravila so tu in ne v brand.css, ker morajo premagati scoped pravila
     te komponente; :global() poskrbi, da Astro selektorja :root ne omeji. */
  :global(:root[data-skin='a']) .nav {
    border-bottom: 1px solid color-mix(in srgb, var(--bbg-gold) 25%, transparent);
    backdrop-filter: blur(8px);
  }
  :global(:root[data-skin='a']) .nav a { letter-spacing: 0.06em; }
  :global(:root[data-skin='a']) .nav__znak img { height: 44px; }
  /* Preklopnik teme je pri A okrogel, brez ostrih vogalov. */
  :global(:root[data-skin='a']) .nav__tema {
    border-width: 1.5px;
    border-radius: 999px;
  }
  /* Zlata podlaga zahteva temno besedilo — papirnato pade na 1,9 :1,
     ink #171310 na zlati #C9A227 doseže 7,64 :1. Tudi tu mora biti .nav
     v selektorju, da premaga pravilo zgoraj. */
  :global(:root[data-skin='a']) .nav .nav__cta,
  :global(:root[data-skin='a']) .nav .nav__cta:link,
  :global(:root[data-skin='a']) .nav .nav__cta:visited {
    color: var(--bbg-ink);
    font-weight: 600;
  }

  /* --- Ozek zaslon --- */
  @media (max-width: 820px) {
    .nav__vrstica { gap: 12px; }
    .nav__znak img { height: 36px; }

    .nav__jezik { order: 2; margin-left: auto; }
    .nav__tema { order: 3; }
    .nav__burger {
      display: grid;
      order: 4;
      margin-left: 0;
    }
    /* Brez JS gumb ničesar ne odpre, zato ga ni. Zastavico postavi
       is:inline skripta nad navigacijo. */
    :global(html:not([data-js='da'])) .nav__burger { display: none; }

    /* Meni postane pravi blok pod vrstico in se razteza po celotni širini. */
    .nav__meni {
      display: flex;
      order: 5;
      flex: 0 0 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      margin: 4px 0 0;
      padding: 8px 0 12px;
      border-top: 1px solid var(--bbg-obroba);
    }
    .nav__meni a {
      order: 0;
      width: 100%;
      padding: 11px 2px;
      font-size: 16px;
    }
    .nav__meni .nav__cta {
      order: 0;
      width: auto;
      margin-top: 10px;
      padding: 11px 22px;
    }
    /* Zaprt meni skrijemo samo, kadar ga JS lahko spet odpre. */
    :global(html[data-js='da']) .nav[data-meni='zaprt'] .nav__meni { display: none; }

    :global(:root[data-skin='a']) .nav__burger {
      border-width: 1.5px;
      border-radius: 999px;
    }
  }
</style>
