---
/* ============================================================
   Hero sekcija — fullbleed fotografija.

   Zgodovina odločitve je v docs/design/hero-smer-b.md: razdeljena
   postavitev (smer b) je bila implementirana in po pregledu na živi
   strani opuščena, ker je fotografija čez ves zaslon močnejša. Iz nje
   sta preživela HeroMedij (zdaj s tremi stanji) in napovednik, ta v
   obliki nalepke.

   Kaj je kje:
     ozadje    → HeroMedij (posnetek | slideshow | ena slika)
     zavesa    → tu; ista v obeh temah, ker se fotografija s temo ne menja
     plasti    → tu; katera velja, pove aktivnePlasti() OB GRADNJI
     nalepka   → tu; naslednji javni dogodek ali nič

   Elementi smeri C (badge, nalepka pod fotografijo, uokvirjena
   fotografija) ostajajo v oznakah in so pri A skriti — pravilo iz
   AGENTS.md.
   ============================================================ */
import { Image } from 'astro:assets';
import HeroMedij from './HeroMedij.astro';
import znakZlat from '../assets/brand/bbg-znak-zlat.svg';
import fotoHero from '../assets/foto/orkester/kotar-dirigent-energija.jpg';
import { slovar, type Jezik } from '../i18n';
import { naslednjiJavni, prihajajociKoncerti, pripravi } from '../lib/koncerti';
import { aktivnePlasti } from '../lib/hero-plasti';
import { prelivCss } from '../data/hero-zavesa.mjs';

interface Props {
  jezik: Jezik;
}
const { jezik } = Astro.props;
const t = slovar(jezik);

const naslednji = naslednjiJavni(
  prihajajociKoncerti().map((k) =>
    pripravi(k, jezik, { ob: t.koncerti.ob, brezPrizorisca: t.koncerti.brezPrizorisca }),
  ),
);

function potDogodka(slug: string): string {
  return jezik === 'en' ? `/en/events/${slug}/` : `/dogodki/${slug}/`;
}

/* Plasti se razrešijo TU, torej ob gradnji. Statična stran nima drugega
   trenutka; za svežino skrbi dnevni redeploy (glej src/data/hero-plasti.ts). */
const plasti = aktivnePlasti();
const sneg = plasti.find((p) => p.tip === 'sneg');
const jubilej = plasti.find((p) => p.tip === 'jubilej');

/* Snežinke so razporejene po determinističnem zaporedju in ne z
   Math.random(): naključje bi ob vsaki gradnji dalo drug HTML in s tem
   po nepotrebnem razveljavilo predpomnilnik. */
const KOSOV = Number(sneg?.parametri.kosov ?? 14);
const sneznice = Array.from({ length: KOSOV }, (_, i) => ({
  levo: ((i * 37) % 100) + (i % 3),
  zamik: ((i * 1.7) % 9).toFixed(1),
  trajanje: (11 + ((i * 3) % 7)).toFixed(0),
  velikost: [3, 4, 5][i % 3],
  odmik: [6, -4, 9][i % 3],
}));
---

<header class="hero" style={`--hero-zavesa: ${prelivCss()}`}>
  <HeroMedij jezik={jezik} alt={t.hero.fotoAlt} />

  {/* Zavesa je ista v OBEH temah: fotografija se s temo ne menja, zato se
      ne sme ne zavesa. Sam preliv pride iz src/data/hero-zavesa.mjs —
      isti vir bere skripta, ki kontrast meri (npm run kontrast). */}
  <div class="hero__zavesa" aria-hidden="true"></div>

  {sneg && (
    <div class="plast plast--sneg" aria-hidden="true">
      {sneznice.map((s) => (
        <i
          style={`--levo:${s.levo}%;--zamik:${s.zamik}s;--trajanje:${s.trajanje}s;--velikost:${s.velikost}px;--odmik:${s.odmik}px`}
        ></i>
      ))}
    </div>
  )}

  {jubilej && (
    <div class="plast plast--jubilej">
      {/* ZAČASNO. Pentljica je placeholder, dokler ne dobimo grafike —
          kaj potrebujem, je zapisano v docs/design/hero-smer-b.md. */}
      <svg viewBox="0 0 96 120" role="img" aria-label={String(jubilej.parametri.leta)} class="jubilej__znak">
        <path d="M8 0h80v96L48 76 8 96z" fill="currentColor" opacity="0.92"></path>
        <path d="M8 96 48 76l40 20-8 16-32-16-32 16z" fill="currentColor" opacity="0.6"></path>
        <text x="48" y="54" text-anchor="middle" class="jubilej__stevilka">{jubilej.parametri.leta}</text>
      </svg>
      <span class="jubilej__napis">
        {jubilej.parametri.kaj === 'orkestra' ? t.hero.jubilejOrkestra : t.hero.jubilejDrustva}
      </span>
    </div>
  )}

  <div class="ovoj hero__mreza">
    <div class="hero__besedilo">
      <p class="bbg-badge bbg-rot-badge hero__badge">{t.hero.badge}</p>
      {/* Ime skupine je H1 strani. Vidni nosilec imena je logotip, ta pa je
          slika — brez tega naslova naslovnica H1 ne bi imela. */}
      <h1 class="naslov-za-bralnike">{t.hero.znakAlt}</h1>
      <img src={znakZlat.src} alt="" class="hero__znak bbg-rot-znak" width="420" />
      <p class="hero__slogan">{t.hero.slogan}</p>
      <p class="hero__gumbi">
        <a href="#organizatorji" class="bbg-gumb">{t.hero.gumbNastop}</a>
        <a href="#pridruzi-se" class="bbg-gumb bbg-gumb--obris">{t.hero.gumbPridruzi}</a>
      </p>
    </div>

    {/* Uokvirjena fotografija smeri C. Pri A je skrita — glej AGENTS.md. */}
    <div class="hero__foto">
      <Image src={fotoHero} alt={t.hero.fotoAlt} width={900} loading="lazy" class="bbg-rot-foto" />
      <span class="hero__nalepka bbg-rot-nalepka">{t.hero.nalepka}</span>
    </div>
  </div>

  {/* Napovednik kot nalepka. Brez prihajajočega javnega dogodka nalepke
      ni — nadomestnega besedila namenoma nima, ker prazna nalepka ni
      nalepka, ampak luknja. */}
  {naslednji && (
    <a class="napovednik" href={potDogodka(naslednji.slugPrikaz)}>
      <span class="napovednik__oznaka">{t.hero.napovedujemo}</span>
      <span class="napovednik__datum">{naslednji.datumPrikaz}</span>
      <span class="napovednik__naziv">{naslednji.nazivPrikaz}</span>
      {naslednji.lokacija && <span class="napovednik__kraj">{naslednji.lokacijaPrikaz}</span>}
    </a>
  )}
</header>

<style>
  .hero {
    position: relative;
    /* overflow vidno, ker nalepka namenoma gleda čez spodnji rob;
       fotografijo obrezuje HeroMedij sam. */
    overflow: visible;
    display: flex;
    align-items: flex-end;
    min-height: 88vh;
    padding: 0 0 72px;
    background: var(--bbg-bg);
  }

  /* --- Zavesa ---------------------------------------------------------
     Vrednosti preliva NISO tu: so v src/data/hero-zavesa.mjs, ker jih poleg
     te komponente bere tudi skripta, ki meri kontrast. Dve kopiji bi se
     lahko razšli, meritev pa bi še naprej poročala, da je vse v redu.

     Zakaj navpičen preliv in ne temna ploskev pod besedilom: ploskev bi
     morala biti zasidrana na stolpec .ovoj (največ 1180 px, sredinsko),
     zavesa pa pokriva celotno širino. Na 3440 px se zasidranje na odstotek
     širine in dejanski položaj besedila razideta — ploskev konča levo od
     besedila. Navpičen preliv te odvisnosti nima.

     Kontrast na vseh slikah v mapi preveri `npm run kontrast`; ista preverba
     teče v GitHub Actions ob vsakem PR in potisku na main. */
  .hero__zavesa {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--hero-zavesa);
  }

  .hero__mreza { position: relative; z-index: 2; width: 100%; }

  .naslov-za-bralnike {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .hero__badge { margin: 0 0 20px; }
  .hero__znak { width: min(420px, 86%); height: auto; display: block; }
  .hero__slogan {
    margin: 22px 0 30px;
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 600;
    font-style: italic;
    color: var(--bbg-naslov);
    max-width: 30rem;
  }
  .hero__gumbi { margin: 0; display: flex; gap: 18px; flex-wrap: wrap; }

  .hero__foto { position: relative; }
  .hero__foto img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--bbg-r-l);
    border: 3px solid var(--bbg-gold);
    box-shadow: var(--bbg-senca-foto);
  }
  .hero__nalepka {
    position: absolute;
    bottom: -16px;
    left: -14px;
    background: var(--bbg-nalepka-bg);
    color: var(--bbg-nalepka-besedilo);
    font-family: var(--bbg-font-naslov);
    font-size: 14px;
    padding: 9px 16px;
    border-radius: var(--bbg-r-s);
  }

  /* --- Napovednik kot nalepka ---------------------------------------
     Nalepljena čez spodnji rob fotografije: rahel zasuk in mehka senca,
     da bere kot kos papirja in ne kot okno vmesnika. */
  .napovednik {
    position: absolute;
    z-index: 3;
    right: clamp(16px, 5vw, 72px);
    bottom: -26px;
    /* Največ 3 stopinje: pri več se besedilo v več vrsticah opazno
       nagne in bralec začne nagibati glavo. */
    transform: rotate(-2.6deg);
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: min(22rem, 78vw);
    /* Dotikalna tarča je z vsebino tako ali tako večja od 44 px; minimum
       zapišemo, ker se vsebina lahko skrajša. */
    min-height: 44px;
    padding: 14px 18px 15px;
    text-decoration: none;
    background: var(--bbg-paper);
    color: var(--bbg-ink);
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.25),
      0 10px 24px rgba(0, 0, 0, 0.32);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .napovednik:hover,
  .napovednik:focus-visible {
    transform: rotate(-1.4deg) translateY(-2px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.25),
      0 14px 30px rgba(0, 0, 0, 0.38);
  }
  /* Obris sledi zasukanemu elementu, ker je transform na njem samem in
     ne na starševskem ovoju. */
  .napovednik:focus-visible {
    outline: 2px solid var(--bbg-gold-dark);
    outline-offset: 3px;
  }
  .napovednik__oznaka {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--bbg-ink) 62%, var(--bbg-paper));
  }
  .napovednik__datum {
    font-family: var(--bbg-font-naslov);
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .napovednik__naziv {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2px;
  }
  .napovednik__kraj {
    font-size: 13px;
    color: color-mix(in srgb, var(--bbg-ink) 70%, var(--bbg-paper));
  }

  /* --- Plast: sneg ---------------------------------------------------
     Redke počasne snežinke na omejenem številu elementov. Brez canvasa in
     brez partiklov: 14 kosov je meja, pri kateri je še vzdušje in ne že
     vremenska napoved. */
  .plast { position: absolute; inset: 0; pointer-events: none; }
  .plast--sneg { z-index: 2; overflow: hidden; }
  .plast--sneg i {
    position: absolute;
    top: -12px;
    left: var(--levo);
    width: var(--velikost);
    height: var(--velikost);
    border-radius: 50%;
    background: rgba(243, 235, 216, 0.55);
    animation: sneg-pada var(--trajanje) linear var(--zamik) infinite;
  }
  @keyframes sneg-pada {
    from { transform: translate3d(0, -12px, 0); opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    to { transform: translate3d(var(--odmik), 92vh, 0); opacity: 0; }
  }

  /* --- Plast: jubilej ------------------------------------------------ */
  .plast--jubilej {
    z-index: 3;
    inset: 0 auto auto clamp(16px, 4vw, 56px);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: max-content;
  }
  .jubilej__znak {
    width: clamp(46px, 5vw, 64px);
    height: auto;
    color: var(--bbg-gold);
    filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.45));
  }
  .jubilej__stevilka {
    fill: var(--bbg-black);
    font-family: var(--bbg-font-naslov);
    font-size: 40px;
    font-weight: 600;
  }
  .jubilej__napis {
    margin-top: 10px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--bbg-gold-light);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  /* --- Predogled smeri C --------------------------------------------
     C obdrži dvostolpčni hero z uokvirjeno fotografijo; fullbleed
     ozadje, zavesa in plasti so pri njem skriti. */
  :global(:root[data-skin='c']) .hero {
    display: block;
    min-height: 0;
    padding: 70px 0 90px;
    background:
      radial-gradient(
        60% 55% at 78% 30%,
        color-mix(in srgb, var(--bbg-gold) 16%, transparent) 0%,
        transparent 100%
      ),
      var(--bbg-bg);
  }
  :global(:root[data-skin='c']) .hero__zavesa,
  :global(:root[data-skin='c']) .plast,
  :global(:root[data-skin='c']) .medij { display: none; }
  :global(:root[data-skin='c']) .hero__mreza {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 44px;
    align-items: center;
  }
  :global(:root[data-skin='c']) .napovednik {
    position: static;
    margin: 26px auto 0;
    transform: none;
  }

  /* Smer A: fotografija smeri C nima mesta, badge in nalepka odpadeta. */
  :global(:root[data-skin='a']) .hero__foto,
  :global(:root[data-skin='a']) .hero__badge,
  :global(:root[data-skin='a']) .hero__nalepka { display: none; }
  :global(:root[data-skin='a']) .hero__znak {
    width: min(430px, 70vw);
    filter: drop-shadow(0 4px 24px rgba(0, 0, 0, 0.5));
  }
  :global(:root[data-skin='a']) .hero__slogan {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(19px, 2.6vw, 26px);
    /* Na zavesi, ne na podlagi strani: svetla zlata je tu izmerjena
       (najslabša slika 5,14 :1), --bbg-naslov bi bil v svetli temi temen
       in bi na fotografiji izginil. */
    color: var(--bbg-gold-light);
    max-width: 560px;
    margin: 18px 0 26px;
  }
  :global(:root[data-skin='a']) .hero__gumbi { gap: 14px; }
  /* Obrisni gumb stoji na temni zavesi tudi v svetli temi, zato ne sme
     vzeti --bbg-povezava (ta je tam temno zlata in bi izginila). */
  :global(:root[data-skin='a']) .hero .bbg-gumb--obris {
    color: var(--bbg-gold-light);
    border-color: var(--bbg-gold);
  }

  @media (max-width: 820px) {
    /* Nalepka postane element toka, zato mora hero dovoliti drugo vrsto.
       align-content ohrani poravnavo na dno, ki jo sicer da align-items. */
    .hero { min-height: 78vh; padding: 0 0 56px; flex-wrap: wrap; align-content: flex-end; }
    :global(:root[data-skin='c']) .hero { padding: 48px 0 60px; }
    :global(:root[data-skin='c']) .hero__mreza { grid-template-columns: 1fr; gap: 34px; }
    .hero__nalepka { left: 0; }

    /* Nalepka pri ozkem zaslonu ne sme čez naslov, slogan ali gumbe.
       Zato izstopi iz absolutne postavitve in se postavi POD gumbe;
       zasuk se zmanjša na 1,2°, ker je element tam širok in bi se pri
       večjem kotu vogal opazno dvignil nad besedilo pod njim. */
    .napovednik {
      position: static;
      /* Stranski odmik je odmik strani (--bbg-rob), ker nalepka tu ni
         več v .ovoj in bi se sicer dotaknila roba zaslona. */
      margin: 26px var(--bbg-rob) 0;
      max-width: none;
      transform: rotate(-1.2deg);
    }
    .napovednik:hover,
    .napovednik:focus-visible { transform: rotate(-0.5deg) translateY(-2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .plast--sneg { display: none; }
    .napovednik { transition: none; }
    .napovednik:hover,
    .napovednik:focus-visible { transform: rotate(-2.6deg); }
  }
</style>
